orthant 2 patch

@ 2 0 0 07ee8aa04c56f92d0a8182de723ed687
+   /** The type Setup made for the ascription of an anonymous class instance, attached to
+    *  the `Typed` node. See the `Typed` case of the traverser.
+    */
+   val AnonymousAscription: util.Property.Key[Type] = util.Property.Key()
+

@ 1 0 0 1ae9d1667c4332a00b63d6f151261b74
+           // The type goes on the ascription, not on `tpt`: two expansions of one inline
+           // method or macro in a unit share the `tpt` node, which can hold one type, and
+           // the capture set variables of that type would belong to the first expansion --
+           // the second would be checked against the scope of the first.

@ 0 1 0 0219036cb1d9b8ef0d3699d6098912a0
+           tree.putAttachment(Setup.AnonymousAscription,
+             transformInferredType(tpt.tpe, NoSymbol, meetIntersections = true))
