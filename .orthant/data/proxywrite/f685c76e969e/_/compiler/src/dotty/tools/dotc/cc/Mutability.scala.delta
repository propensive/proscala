@ 2 0 0 019d69e90881454704e84ba11c3a4c60
+       /** A value of type `x.type & T` is `x`, so it is `x` which says whether the value
+        *  may be written through; what `T` adds is only what kind of value it is. The
+        *  inliner casts the receiver of an inline method to such a type, where `T` is
+        *  the receiver's type as seen through the proxy of an opaque alias's prefix:
+        *  it shows the alias to be, say, an array, and has no capture set of its own,
+        *  so the capture set of the intersection is empty however `x` is held.
+        */
+       def ofSingleton(ref: SingletonType) =
+         ref.exclusivityInContext(required, stateful) match
+           case Exclusivity.ReadOnly(_) => Exclusivity.ReadOnly(tp)
+           case ex => ex
+
+       tp match
+         case tp: ThisType =>
+           if stateful.derivesFromStateful
+           then ctx.owner.inExclusivePartOf(tp.cls)
+           else Exclusivity.OK
+         case tp: TermRef =>
+           tp.info match
+             case tp1: SingletonType => tp1.exclusivityInContext(required, classified)
+             case _ =>
+               val preEx = tp.prefix match
+                 case prefix: Capability => prefix.exclusivityInContext(required)
+                 case _ => Exclusivity.OK
+               preEx.andAlso(tp.exclusivity(required, stateful))
+         case AndType(tp1: SingletonType, _) => ofSingleton(tp1)
+         case AndType(_, tp2: SingletonType) => ofSingleton(tp2)
+         case _ =>
+           tp.exclusivity(required, stateful)
+
