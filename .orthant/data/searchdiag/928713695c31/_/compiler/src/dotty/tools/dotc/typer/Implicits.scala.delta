@ 2 0 0 0304b991e1bc2ef7115720a514478f22
+
+   /** A `MacroErrorsFailure` from a candidate marked `@internal.diagnostic`: preferred
+    *  over other failures, and rendered verbatim as the missing-implicit message. */
+   class DiagnosticFailure(errors: List[Diagnostic.Error], expectedType: Type, argument: Tree)
+     extends MacroErrorsFailure(errors, expectedType, argument)

@ 2 0 0 02c40ace12786e3301f088c23b8645bc
+       // An `@internal.diagnostic` candidate diagnoses by being expanded while it is
+       // tried, so that its macro can fail the candidate with an account of the search.
+       // Where no expansion can happen at all -- lexically inside an inline method's
+       // body, or at a staging level above zero -- the unexpanded call would be accepted
+       // as the result, shadowing the instances in implicit scope whose absence it exists
+       // to explain, and leaving the call site's type variables unconstrained; its macro
+       // would then run only when the enclosing method is inlined, long after the
+       // search. Such a candidate fails here, so that the search goes on as if it were
+       // absent.
+       def unexpandedDiagnostic: Boolean =
+         config.Proscala.enabled(config.Proscala.DiagnosticGivens)
+         && cand.ref.symbol.hasAnnotation(defn.DiagnosticAnnot)
+         && !adapted.existsSubTree:
+           case Inlined(call, _, _) => call.symbol == cand.ref.symbol
+           case _ => false

@ 1 0 0 1c9568571404b9e915c02dc31cd62bbe
+          || unexpandedDiagnostic

@ 1 0 0 1068a9d5335d8421024dc29ba2f2d816
