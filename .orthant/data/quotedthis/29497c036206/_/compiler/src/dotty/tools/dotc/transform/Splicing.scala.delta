@ 3 0 0 1957b4b956a1f75c1f247edd51fbe270
+     /** If `tree` refers to a member that a class defined in the current quote inherits,
+      *  through the `this` of that class, its type; otherwise `NoType`. The member is not
+      *  itself defined in the quote, but the reference is as local to the quote as one to
+      *  a member the class defines: outside the quote there is no such `this`.
+      */
+     private def capturedThisRef(tree: Tree)(using Context): Type = tree.tpe match
+       case tpe @ TermRef(prefix: ThisType, _) if tree.isTerm && isCaptured(prefix.cls) => tpe
+       case _ => NoType
+
+     /** Does `tree` refer to a term defined in the current quote, or to a member inherited
+      *  by a class defined in it, through that class's `this`?
+      */
+     private def isCapturedRef(tree: Tree)(using Context): Boolean =
+       isCaptured(tree.symbol) || capturedThisRef(tree).exists
+

@ 0 1 0 049af33ecaf42b7f1585de6343d3f4cf
+       // An inherited member is keyed by the reference, not by its symbol: two classes
+       // of the quote may inherit the same member.
+       val key: Symbol | TermRef = capturedThisRef(tree) match
+         case tpe: TermRef if !isCaptured(tree.symbol) => tpe
+         case _ => tree.symbol
+       val bindingSym = refBindingMap.getOrElseUpdate(key, (tree, newBinding))._2
