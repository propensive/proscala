@ 1 0 0 022ce308886a223b00d6b0628e68cf45
+     // The proxy's type for capture checking goes in an attachment that only cc Setup
+     // reads (see `ProxyCaptures`), so that typing the expansion sees upstream's binding
+     if proxyTpt.exists && ((proxyTpt ne bindingType) || proxyInferred) then
+       binding.putAttachment(ProxyCaptures, (proxyTpt, proxyInferred))

