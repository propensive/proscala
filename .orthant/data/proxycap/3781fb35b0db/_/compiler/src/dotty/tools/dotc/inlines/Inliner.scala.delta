+   /** Under capture checking, the type an inline argument proxy is to be checked at, and
+    *  whether it is inferred: read by cc Setup in place of the binding's own type tree.
+    */
+   private[dotc] val ProxyCaptures = new util.Property.StickyKey[(Type, Boolean)]
