@ 0 1 0 085cb3c34c92b7341f963ecb49f4dbbc
+             tree.getAttachment(inlines.Inliner.ProxyCaptures) match
+               case Some((proxyType, inferred)) =>
+                 // An inline argument proxy is checked at the type the Inliner chose for it
+                 val tpt1 = TypeTree(proxyType, inferred).withSpan(tpt.span)
+                 transformResultType(tpt1, sym)
+                 // A proxy bounded by its parameter is `T^{inferred} & Any^{bound}`. The bound
+                 // has to reach the inferred set itself, as an intersection of the two sets:
+                 // an inferred type is not checked against, only added to. (`normalizeCaptures`
+                 // no longer does this for intersections in general, since intersecting two
+                 // sets that are both known only later can come out too small; here one side
+                 // is a variable, so nothing is decided before cc.)
+                 val nuType = tpt1.nuType match
+                   case AndType(tp1 @ CapturingType(parent1, refs1), tp2 @ CapturingType(parent2, refs2))
+                   if inferred && tp1.isBoxed == tp2.isBoxed =>
+                     CapturingType(AndType(parent1, parent2), refs1 ** refs2, tp1.isBoxed)
+                   case nuType => nuType
+                 tpt.setNuType(nuType)
+               case None =>
+                 transformResultType(tpt, sym)

