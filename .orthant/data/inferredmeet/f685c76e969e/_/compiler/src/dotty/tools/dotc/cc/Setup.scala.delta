@ 2 0 0 099341a010d0987c07676c41bdf8dfbe
+     /** Is `sym` a parameter of an anonymous function? */
+     private def isClosureParam(sym: Symbol)(using Context): Boolean =
+       sym.is(Param) && sym.owner.isAnonymousFunction
+
+     /** Is `tree` the definition of an anonymous class followed by its instantiation,
+      *  as the right-hand side of a definition whose type is that of the instance?
+      */
+     private def isAnonymousInstanceBlock(tree: Tree)(using Context): Boolean = tree match
+       case Block(_, expr) => isAnonymousInstanceBlock(expr)
+       case Typed(expr, _) => isAnonymousInstanceBlock(expr)
+       case _ => isAnonymousInstance(tree)
+
