#!/usr/bin/env bash
#
# proscala-tree — build a source tree: any scala/scala3 commit plus the Proscala patches.
#
# Usage:
#   bin/proscala-tree <target> [<dir>] [--only <patch>] [--allow-stale] [--allow-missing] [--reset]
#   bin/proscala-tree <target> --plan            # say what would be built, change nothing
#
# <target> is a stream (3.9, 3.10: its pinned UPSTREAM_SHA and its tested build
# config), or any scala/scala3 commit: a release tag (3.10.0, 3.9.0-RC3), a branch
# (main, lts-3.9, release-3.10.1), a nightly version (3.10.2-RC1-bin-20261010-
# bb20dff-NIGHTLY) or a commit id. Only that commit is fetched (with history back
# to PROSCALA_SINCE in a shallow clone).
#
# Creates a git worktree at <dir> (default worktrees/<target>) with, above the
# target, one commit for each patch whose bounds include it (see patches/<patch>/meta):
# the patch as the Orthant store has it at that commit. Then it overlays the build,
# so `make` works there.
#
#   --only <patch>   just `zflags` and <patch>
#   --allow-stale    build even if upstream has changed lines which some patch changes
#                    or sits beside: the patch's own lines are used there, as a
#                    three-way merge would have them (bin/proscala-fill records the
#                    ones which are right; the rest want fixing in the tree, and
#                    bin/proscala-export --adapt)
#   --allow-missing  build even if the store has nothing, at this commit, for some
#                    patch in range (the tree then lacks it; those left out are listed)
#   --reset          replace an existing <dir>; refused if it holds work that has
#                    not been exported back to the store (see bin/proscala-export)

set -euo pipefail
PROSCALA_PROG=proscala-tree
# shellcheck source=proscala-lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/proscala-lib.sh"

spec="" dir="" only="" reset=0 stale=0 allow=0 planonly=0
while [ $# -gt 0 ]; do
  case "$1" in
    --only)          only="${2:-}"; [ -n "$only" ] || die "--only needs a patch name"; shift 2 ;;
    --reset)         reset=1; shift ;;
    --allow-stale|--3way) stale=1; shift ;;
    --allow-missing) allow=1; shift ;;
    --plan)          planonly=1; shift ;;
    --continue)      die "--continue is no more: a patch which does not carry cleanly is built with --allow-stale, and put right in the tree" ;;
    -h|--help)       sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option $1" ;;
    *)  if [ -z "$spec" ]; then spec="$1"
        elif [ -z "$dir" ]; then dir="$1"
        else die "too many arguments"; fi
        shift ;;
  esac
done
[ -n "$spec" ] || die "no target given (a stream: $(streams | tr '\n' ' ')or a scala/scala3 tag, branch, nightly or commit)"
need_orthant
if [ -n "$only" ]; then in_series "$only" || die "'$only' is not a patch of the store"; fi
dir="${dir:-$PROSCALA_ROOT/worktrees/$(printf '%s' "$spec" | tr '/:' '__')}"
case "$dir" in /*) ;; *) dir="$PWD/$dir" ;; esac

# --- the plan ------------------------------------------------------------------
t="$(resolve_target "$spec")"
plan="$(mktemp "${TMPDIR:-/tmp}/proscala-plan.XXXXXX")"
trap 'rm -f "$plan"; store_drop' EXIT
show_plan() {
  awk -F'\t' '{
    if ($2 == "plain") printf "   %-20s plain\n", $1
    else if ($2 == "stale") printf "   %-20s STALE: upstream changed lines it changes, or sits beside\n", $1
    else if ($2 == "out") printf "   %-20s out    (%s)\n", $1, $3
    else if ($2 == "missing") printf "   %-20s MISSING: the store has nothing for it here\n", $1
  }' "$plan"
}
store_plan "$t" "$plan"

if [ "$planonly" = 1 ]; then
  note "scala/scala3 $(g log -1 --format='%h %ad' --date=short "$t") ($spec):"
  show_plan
  exit 0
fi

# overlay <dir> — the build from this checkout's HEAD: a stream's own config, or
# for any other target mk/target.mk, generated from the tree's sbt build
overlay() {
  local d="$1" profile base sjs head
  head="$(g rev-parse HEAD)"
  if is_stream "$spec"; then
    profile="$spec"
    (cd "$d" && PROSCALA_MAIN="$head" "$PROSCALA_ROOT/bin/proscala-overlay" "$profile" >/dev/null)
  else
    profile=target
    read -r base sjs < <("$PROSCALA_ROOT/bin/proscala-buildconf" "$d")
    (cd "$d" && PROSCALA_MAIN="$head" PROSCALA_SCALAJS_VERSION="$sjs" "$PROSCALA_ROOT/bin/proscala-overlay" "$base" >/dev/null)
  fi
  printf '%s\n' "$profile" > "$d/.proscala-stream"
  note "done. Build with:  cd $d && make"
}

# --- the plan must be complete -----------------------------------------------------
missing="$(plan_names "$plan" missing)"
stales="$(plan_names "$plan" stale)"
if [ -n "$missing$stales" ]; then show_plan >&2; fi
if [ -n "$stales" ]; then
  if [ "$stale" = 0 ]; then
    die "upstream has changed beneath: ${stales}at $spec. bin/proscala-fill $spec records those whose change is unaltered; --allow-stale builds with each as it stands, to be put right in the tree (see AGENTS.md, 'Covering a new target')"
  fi
  warn "building $spec with, as they stand: $stales"
fi
if [ -n "$missing" ]; then
  if [ "$allow" = 0 ]; then
    die "the store has nothing at $spec for: ${missing}. Use --allow-missing to build without them, and make them there (see AGENTS.md, 'Covering a new target')"
  fi
  warn "building $spec WITHOUT: $missing"
fi

# --- the commits: one for each patch which does something here ---------------------------
head="$t" n=0
built="$(mktemp "${TMPDIR:-/tmp}/proscala-built.XXXXXX")"
if [ -z "$only" ]; then
  while IFS=$'\t' read -r p st _; do
    case "$st" in plain|stale) ;; *) continue ;; esac
    head="$(commit_patch "$p" "${STORE_POST[$p]}" "$head")"
    printf '%s\t%s\t%s\n' "$p" "$(diff_id "${STORE_PRE[$p]}" "${STORE_POST[$p]}")" "$(payload_id "${STORE_PRE[$p]}" "${STORE_POST[$p]}")" >> "$built"
    n=$((n + 1))
  done < "$plan"
else
  # just zflags, and the one patch's change made to what zflags leaves
  [ -n "${STORE_POST[zflags]:-}" ] && [ -n "${STORE_POST[$only]:-}" ] || die "the store has nothing for zflags or $only at $spec"
  head="$(commit_patch zflags "${STORE_POST[zflags]}" "$head")"; n=1
  printf '%s\t%s\t%s\n' zflags "$(diff_id "${STORE_PRE[zflags]}" "${STORE_POST[zflags]}")" "$(payload_id "${STORE_PRE[zflags]}" "${STORE_POST[zflags]}")" >> "$built"
  if [ "$only" != zflags ]; then
    idx="$(mktemp "${TMPDIR:-/tmp}/proscala-index.XXXXXX")"
    GIT_INDEX_FILE="$idx" g read-tree "${STORE_POST[zflags]}"
    gdiff "${STORE_PRE[$only]}" "${STORE_POST[$only]}" | GIT_INDEX_FILE="$idx" g apply --cached -3 - >/dev/null 2>&1 \
      || { rm -f "$idx"; die "$only does not apply to $spec with zflags alone: it is written against the patches before it"; }
    tree="$(GIT_INDEX_FILE="$idx" g write-tree)"; rm -f "$idx"
    head="$(commit_patch "$only" "$tree" "$head")"; n=2
    printf '%s\t%s\t%s\n' "$only" "$(diff_id "${STORE_POST[zflags]}" "$tree")" "$(payload_id "${STORE_POST[zflags]}" "$tree")" >> "$built"
  fi
fi

# --- an existing tree --------------------------------------------------------
if [ -e "$dir" ]; then
  [ "$reset" = 1 ] || { rm -f "$built"; die "$dir already exists (--reset rebuilds it)"; }
  git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "$dir exists and is not a git worktree; remove it by hand"
  op="$(in_progress "$dir")"
  [ -z "$op" ] || die "$dir is in the middle of an operation ($op); finish or abort it first"
  [ -z "$(git -C "$dir" status --porcelain --untracked-files=no)" ] \
    || die "$dir has uncommitted changes; commit and export them, or discard them, first"
  # Discarding the tree must lose nothing: each commit above its base changes just
  # what it did when it was built, or what the store has the patch change.
  base="$(tree_base "$dir")"
  declare -A now=()
  if [ "$base" = "$t" ]; then
    while IFS=$'\t' read -r p st _; do
      case "$st" in plain|stale) now[$p]="$(diff_id "${STORE_PRE[$p]}" "${STORE_POST[$p]}")" ;; esac
    done < "$plan"
  fi
  while IFS= read -r c; do
    short="$(git -C "$dir" rev-parse --short "$c")"
    name="$(commit_patch_name "$dir" "$c")"
    cid="$(diff_id "$c^" "$c")"
    if [ "$cid" = "$(manifest_field "$dir" "$name" 2)" ] || [ "$cid" = "${now[$name]:-}" ]; then continue; fi
    die "$dir: commit $short ($name) holds changes which are not in the store; run bin/proscala-export first"
  done < <(git -C "$dir" rev-list --reverse "$base..HEAD")
  # Keep the old commits reachable: a mistaken reset can be undone from here.
  key="$(basename "$dir")"
  g update-ref -m "proscala-tree --reset" "refs/proscala/$key/prev" "$(git -C "$dir" rev-parse HEAD)"
  note "removing $dir (its HEAD is kept as refs/proscala/$key/prev)"
  g worktree remove --force "$dir"
fi

# --- build it ----------------------------------------------------------------
mkdir -p "$(dirname "$dir")"
note "creating $dir at scala/scala3 $(g log -1 --format='%h %ad' --date=short "$t") ($spec)"
g worktree add --quiet --detach "$dir" "$head"
gd="$(gitdir_of "$dir")"
printf '%s\n' "$t" > "$gd/proscala-target"
cp "$plan" "$gd/proscala-plan"
mv "$built" "$(manifest_path "$dir")"
note "$n patch$([ "$n" = 1 ] || echo es), one commit each"

# Work in the tree makes commits, so it needs an identity; CI runners have none.
if ! git -C "$dir" config user.email >/dev/null 2>&1; then
  git -C "$dir" config extensions.worktreeConfig true
  git -C "$dir" config --worktree user.name  "Proscala build"
  git -C "$dir" config --worktree user.email "build@proscala.invalid"
fi

overlay "$dir"
