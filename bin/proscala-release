#!/usr/bin/env bash
#
# proscala-release — cut a Proscala release by tagging `main`.
#
# Usage:
#   bin/proscala-release <x.y.z>               # check, tag HEAD v<x.y.z>, push the tag
#   bin/proscala-release <x.y.z> --dry-run     # check, and say what it would do
#   bin/proscala-release <x.y.z> --targets     # print the targets only: "<spec> <commit> <version>"
#
# A Proscala version names a set of features (the patches, with their documented
# guarantees), independent of the Scala it patches. A release is built for every
# scala/scala3 final release 3.<y>.<z> with y >= 9, and for a snapshot of
# scala/scala3 main as it is when the release is cut. Each build is versioned
# <scala version>-proscala-<x.y.z> (3.10.0-proscala-1.0.0,
# 3.10.2-RC1-bin-88be2f5-proscala-1.0.0), with the upstream first so that sbt's
# scalaVersion still reads as a Scala version.
#
# The exact upstream commits are written into the tag's annotation, so the
# release workflow builds what was checked here even after main has moved on.
# Pushing the tag runs .github/workflows/release.yml, which builds every target,
# and only when all have built, creates the GitHub release and publishes to Maven
# Central. Maven Central is append-only: the tag is the point of no return.
#
# It refuses unless HEAD is origin/main, the checkout has no uncommitted changes
# to tracked files, bin/proscala-check passes, the version is greater than every
# earlier release, and every target gets every patch it should.

set -euo pipefail
PROSCALA_PROG=proscala-release
# shellcheck source=proscala-lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/proscala-lib.sh"

version="" mode=release
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) mode=dry; shift ;;
    --targets) mode=targets; shift ;;
    -h|--help) sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option $1" ;;
    *)  [ -z "$version" ] || die "too many arguments"; version="$1"; shift ;;
  esac
done
[[ "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] \
  || die "give the version to release, x.y.z (semantic versioning; see AGENTS.md, 'Versions')"
cd "$PROSCALA_ROOT"

targets="$(release_targets | while read -r spec sha sv; do echo "$spec $sha $(artifact_version "$sv" "$version")"; done)"
if [ "$mode" = targets ]; then printf '%s\n' "$targets"; exit 0; fi

# --- preconditions -------------------------------------------------------------
[ -z "$(git status --porcelain --untracked-files=no)" ] || die "the checkout has uncommitted changes"
git fetch --quiet origin main
if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
  [ "$mode" = dry ] || die "HEAD is not origin/main; a release is cut from exactly what is on main"
  warn "HEAD is not origin/main: a real release would refuse"
fi
tag="v$version"
git ls-remote --exit-code --tags origin "refs/tags/$tag" >/dev/null 2>&1 && die "tag $tag already exists on origin"
latest="$(git ls-remote --tags --refs origin 'v*' | awk '{ print $2 }' | sed 's#refs/tags/v##' \
            | { grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' || true; } | sort -V | tail -1)"
if [ -n "$latest" ] && [ "$(printf '%s\n%s\n' "$latest" "$version" | sort -V | tail -1)" != "$version" -o "$latest" = "$version" ]; then
  die "$version is not greater than the latest release, $latest"
fi

note "checking"
bin/proscala-check >/dev/null || { bin/proscala-check | tail -20; die "bin/proscala-check fails; fix that first"; }

plan="$(mktemp)"; trap 'rm -f "$plan"; if [ -n "${SELECT_INDEX:-}" ]; then rm -f "$SELECT_INDEX"; fi' EXIT
gaps=0
note "Proscala $version, for:"
while read -r spec sha av; do
  select_plan "$sha" "$plan"; rm -f "$SELECT_INDEX"; SELECT_INDEX=""
  miss="$(plan_names "$plan" missing)"
  printf '   %-8s %s  %-40s %s\n' "$spec" "$(git rev-parse --short "$sha")" "$av" "${miss:+MISSING: $miss}"
  [ -z "$miss" ] || gaps=1
done <<< "$targets"
[ "$gaps" = 0 ] || die "some targets lack a version of a patch; cover them first (AGENTS.md, 'Covering a new target')"

msg="Proscala $version

Built for each scala/scala3 commit below, as the version given:

$(while read -r spec sha av; do echo "target $spec $sha $av"; done <<< "$targets")"
if [ "$mode" = dry ]; then
  note "would tag $(git rev-parse --short HEAD) as $tag and push it, with the annotation:"
  printf '%s\n' "$msg" | sed 's/^/   | /'
  exit 0
fi
git tag -a "$tag" -m "$msg"
git push --quiet origin "refs/tags/$tag"
note "tagged and pushed $tag; the Release workflow now builds and publishes it:"
echo "   https://github.com/propensive/proscala/actions/workflows/release.yml"
