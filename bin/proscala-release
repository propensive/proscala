#!/usr/bin/env bash
#
# proscala-release — cut a Proscala release by tagging `main`.
#
# Usage:
#   bin/proscala-release <x.y.z>               # check, tag HEAD <x.y.z>, push the tag
#   bin/proscala-release <x.y.z> --dry-run     # check, and say what it would do
#   bin/proscala-release <x.y.z> --verify      # the checks the Release workflow makes; print the targets
#   bin/proscala-release <x.y.z> --targets     # print the targets only: "<spec> <commit> <version>"
#
# A Proscala version names a set of features (the patches, with their documented
# guarantees), independent of the Scala it patches. A release is built for every
# scala/scala3 final release 3.<y>.<z> with y >= 9, and for a snapshot of each
# upstream branch developing an unreleased version (main, lts-3.<y>,
# release-3.<y>.<z>) as it is when the release is cut. Each build is versioned
# <scala version>-pro-<x.y.z> (3.10.0-pro-1.0.0; a snapshot's scala version is
# the version its branch develops and 16 hex digits of the commit, as in
# 3.10.2-88be2f56a1103b0e-pro-1.0.0), with a full 3.x.y first, without which sbt
# does not treat scalaVersion as Scala 3.
#
# The tag is the trigger: pushing a tag <x.y.z> on main runs
# .github/workflows/release.yml, whose first job runs `--verify` on the tagged
# commit — it must be on main, the version greater than every earlier release,
# bin/proscala-check must pass, and every target must get every patch it should —
# and resolves the targets. Only then are they built, and only once every target
# has built is the GitHub release created, with every target's artefacts and a
# targets.txt naming the upstream commit of each. A tag whose run fails before
# anything is published is deleted by the workflow, so the same version can be
# pushed again once main is fixed. Releases go to GitHub Releases only.
#
# Without options this command makes the same checks here, for a fast answer,
# then tags and pushes; `git tag <x.y.z> && git push origin <x.y.z>` releases
# just the same.

set -euo pipefail
PROSCALA_PROG=proscala-release
# shellcheck source=proscala-lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/proscala-lib.sh"

version="" mode=release
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) mode=dry; shift ;;
    --verify)  mode=verify; shift ;;
    --targets) mode=targets; shift ;;
    -h|--help) sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option $1" ;;
    *)  [ -z "$version" ] || die "too many arguments"; version="$1"; shift ;;
  esac
done
[[ "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] \
  || die "give the version to release, x.y.z (semantic versioning; see AGENTS.md, 'Versions')"
cd "$PROSCALA_ROOT"

# `--verify` is read by the workflow: the targets alone on stdout, everything else on stderr.
if [ "$mode" = verify ]; then exec 3>&1 1>&2; fi

targets="$(release_targets | while read -r spec sha sv; do echo "$spec $sha $(artifact_version "$sv" "$version")"; done)"
if [ "$mode" = targets ]; then printf '%s\n' "$targets"; exit 0; fi

# --- preconditions -------------------------------------------------------------
[ -z "$(git status --porcelain --untracked-files=no)" ] || die "the checkout has uncommitted changes"
git fetch --quiet origin main
if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
  case "$mode" in
    # The workflow checks out the tagged commit, which main may since have moved past.
    verify) git merge-base --is-ancestor HEAD origin/main || die "$(git rev-parse --short HEAD) is not on main; a release is cut from main" ;;
    dry)    warn "HEAD is not origin/main: a real release would refuse" ;;
    *)      die "HEAD is not origin/main; a release is cut from exactly what is on main" ;;
  esac
fi
tag="$version"
if [ "$mode" != verify ] && git ls-remote --exit-code --tags origin "refs/tags/$tag" >/dev/null 2>&1; then
  [ "$mode" = dry ] || die "tag $tag already exists on origin"
  warn "tag $tag already exists on origin: a real release would refuse"
fi
# A release's tag is its plain version (1.0.0 was first tagged v1.0.0, so a v-prefixed one
# counts too). This repository also holds scala/scala3's own tags, which look like versions
# as well; a release is tagged on main's history, which no upstream commit is part of.
# (`ls-remote` lists an annotated tag twice; its `^{}` line gives the commit.) Under
# `--verify` the tag being released is itself on origin, and is not an earlier release.
latest="$(git ls-remote --tags origin \
            | awk '{ sub("^refs/tags/", "", $2); sub("\\^\\{\\}$", "", $2); commit[$2] = $1 }
                   END { for (t in commit) print commit[t], t }' \
            | { grep -E ' v?[0-9]+\.[0-9]+\.[0-9]+$' || true; } \
            | while read -r c t; do
                [ "${t#v}" != "$version" ] || continue
                if git merge-base --is-ancestor "$c" origin/main 2>/dev/null; then echo "${t#v}"; fi
              done | sort -V | tail -1)"
if [ -n "$latest" ] && [ "$(printf '%s\n%s\n' "$latest" "$version" | sort -V | tail -1)" != "$version" -o "$latest" = "$version" ]; then
  die "$version is not greater than the latest release, $latest"
fi

note "checking"
bin/proscala-check >/dev/null || { bin/proscala-check | tail -20; die "bin/proscala-check fails; fix that first"; }

plan="$(mktemp)"; trap 'rm -f "$plan"; if [ -n "${SELECT_INDEX:-}" ]; then rm -f "$SELECT_INDEX"; fi' EXIT
gaps=0
note "Proscala $version, for:"
while read -r spec sha av; do
  select_plan "$sha" "$plan"; rm -f "$SELECT_INDEX"; SELECT_INDEX=""
  miss="$(plan_names "$plan" missing)"
  printf '   %-8s %s  %-40s %s\n' "$spec" "$(git rev-parse --short "$sha")" "$av" "${miss:+MISSING: $miss}"
  [ -z "$miss" ] || gaps=1
done <<< "$targets"
[ "$gaps" = 0 ] || die "some targets lack a version of a patch; cover them first (AGENTS.md, 'Covering a new target')"

case "$mode" in
  verify)
    printf '%s\n' "$targets" >&3
    exit 0 ;;
  dry)
    note "would tag $(git rev-parse --short HEAD) as $tag and push it; the Release workflow then verifies, builds and publishes"
    exit 0 ;;
esac
git tag -a "$tag" -m "Proscala $version

The Release workflow verifies this tag, resolves the targets it is built for and
records them in the release (targets.txt)."
git push --quiet origin "refs/tags/$tag"
note "tagged and pushed $tag; the Release workflow now verifies, builds and publishes it:"
echo "   https://github.com/propensive/proscala/actions/workflows/release.yml"
