#!/usr/bin/env bash
#
# proscala-check — check that the patches are well-formed and apply where they
# claim to, and that the documentation on `main` agrees with the facts it
# describes, so none of the copies can drift apart unnoticed.
#
# Usage:
#   bin/proscala-check            # check everything, exit 1 on any problem
#   bin/proscala-check -v         # also list the checks that passed
#   bin/proscala-check --quick    # skip proving every version at every anchor
#
# Each fact has exactly one source of truth; the docs are copies, and this
# checks the copies against it:
#
#   which patches apply, in what order   ->  patches/series, patches/<p>/meta
#   which patches a stream carries       ->  the bounds, evaluated at its pin
#   which scala/scala3 commit it is on   ->  UPSTREAM_SHA in mk/<stream>.mk
#   which scala/scala3 branch that is on ->  UPSTREAM_REF in mk/<stream>.mk
#   whether a repro exists               ->  the filesystem, doc/<patch>/repro*/
#                                            (each with a test.sh beside its README)
#   which -Z name enables a patch        ->  config.Proscala, as each stream builds it
#
# The upstream commits it needs are fetched on their own (shallowly) when absent.
# Nothing in the checkout is changed.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."
cd "$ROOT" || exit 1

VERBOSE=0 QUICK=0
for a in "$@"; do
  case "$a" in -v) VERBOSE=1 ;; --quick) QUICK=1 ;; *) echo >&2 "proscala-check: unknown argument $a"; exit 2 ;; esac
done

PROBLEMS=()
problem() { PROBLEMS+=("$*"); }
pass() { [ "$VERBOSE" = 1 ] && echo "   ok: $*"; return 0; }
section() { echo ">> $*"; }

PROSCALA_PROG=proscala-check
# shellcheck source=proscala-lib.sh
. "$ROOT/bin/proscala-lib.sh"
[ -f patches/series ] || { echo >&2 "proscala-check: no patches/series — run from a 'main' checkout"; exit 1; }
mapfile -t STREAMS < <(streams)
TMP="$(mktemp -d "${TMPDIR:-/tmp}/proscala-check.XXXXXX")"
trap 'rm -rf "$TMP"; if [ -n "${SELECT_INDEX:-}" ]; then rm -f "$SELECT_INDEX"; fi' EXIT

# Every commit the meta files name must be present (fetched, in a shallow clone).
mapfile -t ANCHORS < <(all_anchors)
ensure_commits $(for s in "${STREAMS[@]}"; do upstream_sha "$s"; done) ${ANCHORS[@]+"${ANCHORS[@]}"}

# What each stream's pin carries: the plan, and the tree it builds.
declare -A STREAM_TREE=()
for s in "${STREAMS[@]}"; do
  select_plan "$(upstream_sha "$s")" "$TMP/plan.$s"
  STREAM_TREE[$s]="$(GIT_INDEX_FILE="$SELECT_INDEX" git write-tree)"
  rm -f "$SELECT_INDEX"; SELECT_INDEX=""
done
# patches(<stream>) — the patches the stream carries (zflags, the stream base, is not one)
patches() { awk -F'\t' '$2 == "plain" || $2 == "3way" || $2 == "missing" { print $1 }' "$TMP/plan.$1" | { grep -vx zflags || true; }; }

# doc/README.md table: emit "<feature>\t<streams>\t<kind>\t<repro>"
table() {
  awk -F'|' '/^\| *\[/ {
    f=$2; sub(/^ *\[/,"",f); sub(/\].*/,"",f)
    s=$4; k=$5; r=$6
    gsub(/^ +| +$/,"",s); gsub(/^ +| +$/,"",k); gsub(/^ +| +$/,"",r)
    printf "%s\t%s\t%s\t%s\n", f, s, k, r
  }' doc/README.md
}

# --- 1. doc/README.md Streams column vs what each stream carries --------------
section "feature table vs the streams"
while IFS=$'\t' read -r feat streams _ _; do
  expected=""
  for s in "${STREAMS[@]}"; do
    patches "$s" | grep -qx "$feat" && expected="${expected:+$expected, }$s"
  done
  got="$(printf '%s' "$streams" | tr -d ' ')"
  want="$(printf '%s' "$expected" | tr -d ' ')"
  if [ -z "$expected" ] && [ "$got" = "—" ]; then
    pass "$feat streams (none: carried only on other upstreams)"
  elif [ -z "$expected" ]; then
    problem "doc/README.md lists '$feat', which no stream carries (give it '—' in the Streams column if it applies only to other upstreams)"
  elif [ "$got" != "$want" ]; then
    problem "doc/README.md '$feat' Streams = '$streams', but the streams carry it in '$expected'"
  else
    pass "$feat streams"
  fi
done < <(table)

# every patch has a doc directory and a table row
while IFS= read -r p; do
  [ "$p" = zflags ] && continue
  [ -f "doc/$p/$p.md" ] || problem "patches/series lists '$p' but doc/$p/$p.md is missing"
  [ "$(table | cut -f1 | grep -cx "$p")" -gt 0 ] || problem "patches/series lists '$p' but doc/README.md has no row for it"
done < <(series)

# every doc directory is either in the table or deliberately not a patch
for d in doc/*/; do
  f="$(basename "$d")"
  table | cut -f1 | grep -qx "$f" && continue
  # Docs that legitimately have no row: the build (not a patch), patches
  # retired with a dropped stream kept as a record, and documented upstream
  # behaviours the fork deliberately does not patch.
  case "$f" in make|zflags|boundscap|localroots|picklesource) continue ;; esac
  problem "doc/$f/ has no row in doc/README.md (and is not the build, a retired patch or an unpatched upstream record)"
done

# --- 2. Repro column vs the filesystem ---------------------------------------
section "repro column vs the filesystem"
while IFS=$'\t' read -r feat _ _ repro; do
  has_readme=0; [ -f "doc/$feat/repro/README.md" ] && has_readme=1
  has_fixme=0;  [ -f "doc/$feat/repro/FIXME.md" ] && has_fixme=1
  case "$repro" in
    yes*)   [ "$has_readme" = 1 ] || problem "doc/README.md '$feat' Repro says '$repro' but doc/$feat/repro/README.md is missing" ;;
    FIXME*) [ "$has_fixme" = 1 ]  || problem "doc/README.md '$feat' Repro says '$repro' but doc/$feat/repro/FIXME.md is missing" ;;
    n/a|"not extracted")
            if [ "$has_readme" = 1 ] || [ "$has_fixme" = 1 ]; then
              problem "doc/README.md '$feat' Repro says '$repro' but doc/$feat/repro/ exists"
            fi ;;
    *)      problem "doc/README.md '$feat' Repro = '$repro' — expected yes…, FIXME…, n/a or 'not extracted'" ;;
  esac
  # every repro directory must be self-describing, and extra ones must be named
  for rd in doc/"$feat"/repro*/; do
    [ -d "$rd" ] || continue
    rn="$(basename "$rd")"
    [ -f "$rd/README.md" ] || [ -f "$rd/FIXME.md" ] \
      || problem "$rd has neither README.md nor FIXME.md"
    # a reproduction is also executable: bin/proscala-test runs its test.sh
    if [ -f "$rd/README.md" ] && [ ! -f "$rd/test.sh" ]; then
      problem "$rd has a README.md but no test.sh (its executable form, run by bin/proscala-test)"
    fi
    if [ "$rn" != repro ] && ! printf '%s' "$repro" | grep -q "$rn"; then
      problem "doc/$feat/$rn/ exists but the Repro column ('$repro') does not mention it"
    fi
  done
done < <(table)

# --- 3. stream tables in README.md and AGENTS.md vs mk/<stream>.mk -----------
section "stream tables vs mk/<stream>.mk"
for s in "${STREAMS[@]}"; do
  [ -f "mk/$s.mk" ] || continue
  [[ "$(mkvar "$s" UPSTREAM_SHA)" =~ ^[0-9a-f]{40}$ ]] || problem "mk/$s.mk has no full 40-hex UPSTREAM_SHA"
  uref="$(mkvar "$s" UPSTREAM_REF)"
  for f in README.md AGENTS.md; do
    row="$(grep -n "^| *\`$s\` " "$f" | head -1)"
    if [ -z "$row" ]; then
      problem "$f has no stream-table row for $s"
      continue
    fi
    printf '%s' "$row" | grep -q -- "$uref" \
      || problem "$f stream row for $s does not name '$uref' (mk/$s.mk UPSTREAM_REF) — got: ${row#*:}"
    pass "$f stream row $s"
  done
  # and quotes the patch count
  if grep -qE "^ +stream $s +[0-9]+ patches" AGENTS.md; then
    stated="$(grep -oE "^ +stream $s +[0-9]+" AGENTS.md | grep -oE '[0-9]+$' | head -1)"
    actual="$(patches "$s" | wc -l | tr -d ' ')"
    [ "$stated" = "$actual" ] \
      || problem "AGENTS.md says the $s stream carries $stated patches; it carries $actual"
  else
    problem "AGENTS.md does not quote how many patches the $s stream carries"
  fi
done

# --- 4. feature docs must not hardcode a stream ------------------------------
section "feature docs vs stream-specific references"
while IFS=$'\t' read -r feat streams _ _; do
  doc="doc/$feat/$feat.md"
  [ -f "$doc" ] || continue
  mapfile -t named < <(grep -oE '(feature|patches)/3\.[0-9]+/' "$doc" | grep -oE '3\.[0-9]+' | sort -u)
  [ "${#named[@]}" -eq 0 ] && { pass "$feat has no hardcoded stream"; continue; }
  count="$(printf '%s' "$streams" | tr ',' '\n' | grep -c '[0-9]')"
  if [ "$count" -gt 1 ]; then
    problem "$doc names ${named[*]} but the patch is in $streams — use patches/<stream>/"
  else
    only="$(printf '%s' "$streams" | tr -d ' ')"
    for n in "${named[@]}"; do
      [ "$n" = "$only" ] || problem "$doc names stream $n but the patch is only in $only"
    done
  fi
done < <(table)

# --- 5. relative links resolve ------------------------------------------------
# Markdown prose only: fenced blocks and inline code spans are dropped first, or
# Scala like `apply[tag](value: Any)` reads as a link target.
section "relative links"
prose() { # prose <file>
  awk '/^[[:space:]]*```/ { fence = !fence; next } !fence' "$1" | sed -E 's/`[^`]*`//g'
}
while IFS= read -r md; do
  dir="$(dirname "$md")"
  while IFS= read -r link; do
    case "$link" in http*|"#"*|mailto:*|"") continue ;; esac
    target="${link%%#*}"
    [ -z "$target" ] && continue
    [ -e "$dir/$target" ] || problem "$md links to '$target', which does not exist"
  done < <(prose "$md" | grep -oE '\[[^]]*\]\([^)]+\)' | sed -E 's/^\[[^]]*\]\(//; s/\)$//')
done < <({ git ls-files -- '*.md'
            git ls-files --others --exclude-standard -- '*.md' | grep -E '^(doc/|mk/|[^/]+$)'
          } | sed 's|^|./|' | sort -u)

# --- 6. the patches ----------------------------------------------------------------
section "patches"
declare -A IN_SERIES=()
dups="$(series | sort | uniq -d | tr '\n' ' ')"
[ -z "$dups" ] || problem "patches/series lists ${dups}more than once"
[ "$(series | head -1)" = zflags ] || problem "patches/series must start with zflags (the stream base)"
for p in $(series); do
  IN_SERIES[$p]=1
  [ -f "patches/$p/meta" ] || { problem "patches/series lists '$p' but patches/$p/meta does not exist"; continue; }
  # meta: known lines, full commit ids inside the history window
  while read -r k rest; do
    case "$k" in
      needed-from|obsolete-from|absent-from|variant) ;;
      *) problem "patches/$p/meta: unknown line '$k $rest'" ;;
    esac
  done < <(meta "$p")
  for c in $(meta "$p" | awk '$1 ~ /-from$/ { print $2 } $1 == "variant" { for (i = 4; i <= NF; i++) print $i }'); do
    [[ "$c" =~ ^[0-9a-f]{40}$ ]] || { problem "patches/$p/meta: '$c' is not a full commit id"; continue; }
    [ "$(git log -1 --format=%cs "$c")" \> "$PROSCALA_SINCE" ] \
      || problem "patches/$p/meta: $c predates PROSCALA_SINCE ($PROSCALA_SINCE), so a shallow clone cannot see it"
  done
  [ -n "$(variants "$p")" ] || problem "patches/$p has no versions"
  declare -A FILES=()
  while read -r f rev anchors; do
    FILES[$f]=1
    [ -f "patches/$p/$f" ] || { problem "patches/$p/meta names $f, which does not exist"; continue; }
    [ -n "$anchors" ] || problem "patches/$p/$f has no anchor"
    [[ "$rev" =~ ^[1-9][0-9]*$ ]] || problem "patches/$p/$f: revision '$rev' is not a positive number"
    [ "$(patch_commits "patches/$p/$f")" = 1 ] || problem "patches/$p/$f holds $(patch_commits "patches/$p/$f") commits; a version holds exactly one"
    [ "$(patch_trailer "patches/$p/$f")" = "$p" ] || problem "patches/$p/$f's message does not end with the trailer 'Proscala-Patch: $p'"
  done < <(variants "$p")
  for f in patches/"$p"/*.patch; do
    [ -e "$f" ] || continue
    [ -n "${FILES[$(basename "$f")]:-}" ] || problem "$f is not named in patches/$p/meta"
  done
  # two identical files should be one version with two anchors
  dupf="$(for f in patches/"$p"/*.patch; do [ -e "$f" ] && git hash-object "$f"; done | sort | uniq -d | head -1)"
  [ -z "$dupf" ] || problem "patches/$p holds two identical versions; keep one and give it both anchors"
  # versions behind the latest revision still carry an older change
  top="$(max_revision "$p")"
  while read -r f rev _; do
    if [ "$rev" -lt "$top" ]; then echo "   note: patches/$p/$f is at revision $rev, behind $top: it still carries the older change"; fi
  done < <(variants "$p")
  unset FILES
done
for d in patches/*/; do
  p="$(basename "$d")"
  [ -n "${IN_SERIES[$p]:-}" ] || problem "patches/$p/ is not in patches/series"
done

# every stream builds completely, plainly, and registers the -Z flags its docs give
for s in "${STREAMS[@]}"; do
  miss="$(plan_names "$TMP/plan.$s" missing)"
  [ -z "$miss" ] || problem "the $s stream (scala/scala3 $(upstream_sha "$s" | cut -c1-10)) has no applying version of: $miss"
  pass "$s: every patch it carries applies"
  registry="$(git cat-file blob "${STREAM_TREE[$s]}:compiler/src/dotty/tools/dotc/config/Proscala.scala" 2>/dev/null || true)"
  [ -n "$registry" ] || problem "$s: the patches build no compiler/src/dotty/tools/dotc/config/Proscala.scala"
  while IFS=$'\t' read -r feat streams flag; do
    [ "$(printf '%s' "$streams" | tr -d ' ' | tr ',' '\n' | grep -cx "$s")" -gt 0 ] || continue
    name="${flag#\`-Z}"; name="${name%\`}"
    [ "$(printf '%s' "$registry" | grep -cF "Feature(\"$name\", \"$feat\"")" -gt 0 ] \
      || problem "doc/README.md gives '$feat' flag '$flag', which the $s stream's config.Proscala does not register for it"
  done < <(awk -F'|' '/^\| *\[/ { f=$2; sub(/^ *\[/,"",f); sub(/\].*/,"",f); s=$4; z=$7; gsub(/^ +| +$/,"",s); gsub(/^ +| +$/,"",z); if (z ~ /^`-Z/) printf "%s\t%s\t%s\n", f, s, z }' doc/README.md)
  pass "$s flags"
done

# every version applies plainly at each of its anchors, where the patch is in range
if [ "$QUICK" = 0 ]; then
  n=0
  for p in $(series); do
    while read -r f rev anchors; do
      for a in $anchors; do
        r="$(in_range "$p" "$a")"
        if [ "$r" != in ]; then problem "patches/$p/$f is anchored at $(git rev-parse --short "$a"), where the patch's bounds exclude it ($r)"; continue; fi
        select_plan "$a" "$TMP/anchor" "$p=patches/$p/$f"; rm -f "$SELECT_INDEX"; SELECT_INDEX=""
        st="$(awk -F'\t' -v p="$p" '$1 == p { print $2 }' "$TMP/anchor")"
        [ "$st" = plain ] || problem "patches/$p/$f does not apply at its anchor $(git rev-parse --short "$a"), after the patches before it"
        n=$((n + 1))
      done
    done < <(variants "$p")
  done
  pass "$n version anchors proved"
fi

# --- report -------------------------------------------------------------------
echo
if [ "${#PROBLEMS[@]}" -eq 0 ]; then
  echo ">> everything is consistent (${#STREAMS[@]} streams)"
  exit 0
fi
echo "!! ${#PROBLEMS[@]} inconsistenc$([ "${#PROBLEMS[@]}" -eq 1 ] && echo y || echo ies):"
for p in "${PROBLEMS[@]}"; do echo "   - $p"; done
exit 1
