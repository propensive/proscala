#!/usr/bin/env bash
#
# proscala-coverage — which patches apply to which scala/scala3 versions.
#
# Usage:
#   bin/proscala-coverage [<target>...]
#
# For each target (default: the streams, every release tag from 3.9.0-RC1 on, and
# the heads of main, lts-3.9 and the release branches) derives the patches exactly
# as bin/proscala-tree would and prints one line: how many are there, how many the
# bounds exclude, and which in-range patches are not there cleanly. Those are the
# gaps to fill: a patch is *stale* where upstream has changed lines it changes or
# sits beside (bin/proscala-fill records the ones which are right as they stand),
# and *missing* where the store has nothing for it (by hand: AGENTS.md, 'Covering
# a new target'). Exits 1 if any target has a gap.

set -euo pipefail
PROSCALA_PROG=proscala-coverage
# shellcheck source=proscala-lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/proscala-lib.sh"

targets=()
while [ $# -gt 0 ]; do
  case "$1" in
    --3way) shift ;;   # as it was once written: stale patches are always told apart now
    -h|--help) sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option $1" ;;
    *) targets+=("$1"); shift ;;
  esac
done
[ "${#targets[@]}" -gt 0 ] || mapfile -t targets < <(default_targets)
need_orthant

plan="$(mktemp)"; trap 'rm -f "$plan"; store_drop' EXIT
gaps=0
printf '%-22s %-21s %5s %4s  %s\n' target commit there out gaps
for spec in "${targets[@]}"; do
  if ! t="$(resolve_target "$spec" 2>/dev/null)"; then printf '%-22s (cannot resolve)\n' "$spec"; continue; fi
  store_plan "$t" "$plan"; store_drop
  miss="$(plan_names "$plan" missing)"
  stales="$(plan_names "$plan" stale)"
  unreal="$(awk -F'\t' '$2 == "out" && $3 ~ /put right/ { print $1 }' "$plan" | tr '\n' ' ')"
  [ -z "$miss$stales" ] || gaps=$((gaps + 1))
  printf '%-22s %-21s %5s %4s  %s%s%s\n' "$spec" "$(g log -1 --format='%h %ad' --date=short "$t")" "$(plan_count "$plan" plain)" \
    "$(plan_count "$plan" out)" "${miss:+missing: $miss}" "${stales:+ stale: $stales}" "${unreal:+ [still there, though out: $unreal]}"
done
[ "$gaps" = 0 ]
