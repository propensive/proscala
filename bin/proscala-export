#!/usr/bin/env bash
#
# proscala-export — write a tree's patches back to the Orthant store.
#
# Usage:
#   bin/proscala-export [<dir>|<target>] [--adapt | --revise] [--obsolete <patch>]... [--remove <patch>]...
#
# Reads the commits above the tree's upstream base (one per patch, each with a
# `Proscala-Patch: <name>` trailer) in <dir>, or in worktrees/<target>, and checks
# in every patch whose commit no longer changes what it did when the tree was
# built, at the tree's base. What that means depends on the change:
#
#   only context      (the patch's own +/- lines are unchanged: the tree was
#                      rebased, or a stale patch was looked at and left): at once
#   a new patch       at once; it joins the chain of patches where the tree has it
#   anything else     you must say which it is:
#     --adapt         this upstream needed the patch done differently: it is checked
#                     in at the base, for that commit and every later one
#     --revise        the patch itself changed (a fix, a feature): it is checked in
#                     at the earliest commit, among those the base descends from,
#                     at which the store has the patch and the change still fits,
#                     so that every commit after that one gets it. Other lines of
#                     history (a branch which forked before it) are listed: they
#                     still carry the old change, until it is made there too
#
#   --obsolete <p>    the tree no longer carries <p> because upstream has made it
#                     unnecessary: <p> gets `obsolete-from <base>`
#   --remove <p>      delete <p> altogether
#
# A patch the target should carry but the tree lacks is an error unless named in
# --obsolete or --remove. Before the store is written, the result is proved:
# deriving the patches at the base anew must rebuild the tree exactly. Nothing is
# committed.

set -euo pipefail
PROSCALA_PROG=proscala-export
# shellcheck source=proscala-lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/proscala-lib.sh"

arg="" mode="" obsolete=() remove=()
while [ $# -gt 0 ]; do
  case "$1" in
    --adapt)    mode=adapt; shift ;;
    --revise)   mode=revise; shift ;;
    --obsolete) [ -n "${2:-}" ] || die "--obsolete needs a patch name"; obsolete+=("$2"); shift 2 ;;
    --remove)   [ -n "${2:-}" ] || die "--remove needs a patch name"; remove+=("$2"); shift 2 ;;
    -h|--help)  sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option $1" ;;
    *)  [ -z "$arg" ] || die "too many arguments"; arg="$1"; shift ;;
  esac
done
[ -n "$arg" ] || die "which tree? give its directory or its target"
if [ -d "$arg" ]; then dir="$(cd "$arg" && pwd)"; else dir="$PROSCALA_ROOT/worktrees/$(printf '%s' "$arg" | tr '/:' '__')"; fi
[ -d "$dir" ] || die "no tree at $dir (bin/proscala-tree makes one)"
op="$(in_progress "$dir")"
[ -z "$op" ] || die "$dir is mid-operation ($op); finish it first"
[ -z "$(git -C "$dir" status --porcelain --untracked-files=no)" ] \
  || die "$dir has uncommitted changes; commit them (with a Proscala-Patch trailer) first"

t="$(tree_base "$dir")"
recorded="$(tree_target "$dir")"
if [ -n "$recorded" ] && [ "$recorded" != "$t" ]; then
  note "the tree has moved from scala/scala3 $(g rev-parse --short "$recorded") to $(g rev-parse --short "$t")"
fi
profile="$(tree_profile "$dir")"
if is_stream "$profile" && [ "$(upstream_sha "$profile")" != "$t" ]; then
  warn "the tree is the $profile stream, but mk/$profile.mk pins $(upstream_sha "$profile" | cut -c1-10), not $(g rev-parse --short "$t"): update UPSTREAM_SHA too"
fi

need_orthant
tmp="$(mktemp -d "${TMPDIR:-/tmp}/proscala-export.XXXXXX")"
# a bound added for --obsolete is taken back if the export does not go through
finished=0
cleanup() {
  local p
  if [ "$finished" = 0 ]; then
    for p in ${obsolete[@]+"${obsolete[@]}"}; do
      if [ -f "$tmp/meta.$p" ]; then cp "$tmp/meta.$p" "$P/$p/meta"; elif [ -e "$tmp/nometa.$p" ]; then rm -f "$P/$p/meta"; fi
    done
  fi
  rm -rf "$tmp"; store_drop
}
trap cleanup EXIT

# --- read the tree -------------------------------------------------------------
names=() commits=()
declare -A seen=() dropping=() commit_of=()
for p in ${obsolete[@]+"${obsolete[@]}"} ${remove[@]+"${remove[@]}"}; do
  in_series "$p" || die "'$p' is not a patch of the store"
  dropping[$p]=1
done
while IFS= read -r c; do
  short="$(git -C "$dir" rev-parse --short "$c")"
  [ "$(git -C "$dir" rev-list --parents -n1 "$c" | wc -w)" -eq 2 ] \
    || die "commit $short is a merge; a patch must be a single ordinary commit"
  p="$(commit_patch_name "$dir" "$c")"
  [[ "$p" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "commit $short: '$p' is not a valid patch name (lower-case letters and digits, hyphen-separated)"
  [ "$p" != "$(store_root_patch)" ] || die "commit $short: '$p' is a reserved name"
  [ -z "${seen[$p]:-}" ] || die "two commits are both patch '$p' ($short and ${seen[$p]}); squash them into one"
  [ -z "${dropping[$p]:-}" ] || die "the tree still has a commit for '$p', which you asked to drop"
  seen[$p]="$short"; commit_of[$p]="$c"
  names+=("$p"); commits+=("$c")
done < <(git -C "$dir" rev-list --reverse "$t..HEAD")
[ "${#names[@]}" -gt 0 ] || die "$dir has no patch commits above $t"

# The tree's order must agree with the store's; new patches slot in where they are.
known=() ; for p in "${names[@]}"; do if in_series "$p"; then known+=("$p"); fi; done
want="$(for p in $(series); do if [ -n "${seen[$p]:-}" ]; then echo "$p"; fi; done)"
[ "$want" = "$(printf '%s\n' ${known[@]+"${known[@]}"})" ] \
  || die "the tree has the patches in a different order from the store (bin/proscala-tree <target> --plan lists it); the order is shared by every target, so reorder the tree"
declare -A after=()
prev="$(store_root_patch)"
for p in "${names[@]}"; do
  if in_series "$p"; then prev="$p"; else after[$p]="$prev"; prev="$p"; fi
done

# --- what the target should carry ------------------------------------------------
store_plan "$t" "$tmp/expect"
v="${VIEW_NAME[$t]}"
declare -A was_pre=() was_post=() was_st=()
while IFS=$'\t' read -r p st detail; do
  was_st[$p]="$st"; was_pre[$p]="${STORE_PRE[$p]}"; was_post[$p]="${STORE_POST[$p]}"
  case "$st" in
    plain|stale|missing)
      [ -n "${seen[$p]:-}" ] || [ -n "${dropping[$p]:-}" ] || [ "$st" = missing ] \
        || die "the target should carry '$p' but the tree has no commit for it (--obsolete $p if upstream made it unnecessary, --remove $p to delete it)" ;;
    out)
      [ -z "${seen[$p]:-}" ] || die "the tree carries '$p', but its bounds exclude this target ($detail); change patches/$p/meta first" ;;
  esac
done < "$tmp/expect"

# --- decide ----------------------------------------------------------------------
declare -A kind=()
stale=() unmarked=()
for i in "${!names[@]}"; do
  p="${names[$i]}"; c="${commits[$i]}"
  nid="$(diff_id "$c^" "$c")"
  mid="$(manifest_field "$dir" "$p" 2)"
  if ! in_series "$p"; then kind[$p]=new; continue; fi
  sid=""; if [ "${was_st[$p]}" != missing ]; then sid="$(diff_id "${was_pre[$p]}" "${was_post[$p]}")"; fi
  if [ "$nid" = "$sid" ]; then kind[$p]=keep; continue; fi
  if [ -n "$mid" ] && [ "$nid" = "$mid" ]; then
    # untouched since the tree was built, yet not what the store has now
    if [ "$recorded" = "$t" ]; then stale+=("$p"); fi
    kind[$p]=context; continue
  fi
  if [ -n "$(manifest_field "$dir" "$p" 3)" ] && [ "$(payload_id "$c^" "$c")" = "$(manifest_field "$dir" "$p" 3)" ]; then kind[$p]=context
  else
    case "$mode" in
      adapt|revise) kind[$p]="$mode" ;;
      *) unmarked+=("$p") ;;
    esac
  fi
done
if [ "${#stale[@]}" -gt 0 ]; then
  die "$dir is out of date: ${stale[*]} changed in the store since it was built, and exporting it would undo that. Rebuild it (bin/proscala-tree <target> --reset refuses if it holds unexported work)."
fi
if [ "${#unmarked[@]}" -gt 0 ]; then
  die "the change to ${unmarked[*]} is more than context. Export again with --adapt (this upstream needs the patch done differently) or --revise (the patch itself changed)."
fi

# --- check in, in the view ---------------------------------------------------------------
for p in ${remove[@]+"${remove[@]}"}; do store_remove_patch "$p"; done
for p in ${obsolete[@]+"${obsolete[@]}"}; do
  if [ -f "$P/$p/meta" ]; then cp "$P/$p/meta" "$tmp/meta.$p"; else : > "$tmp/nometa.$p"; fi
  add_bound "$p" obsolete-from "$t" "dropped at $(g rev-parse --short "$t") by proscala-export: upstream made it unnecessary"
done

# content <commit> <dir> — every document the store knows, or the tree's commits
# change, as the commit has it
git -C "$dir" diff --name-only --no-renames "$t" HEAD > "$tmp/touched"
content() {
  rm -rf "$2"; mkdir -p "$2"
  { store_documents "$VIEW"; cat "$tmp/touched"; } | sort -u > "$tmp/paths"
  git -C "$dir" ls-tree -r --name-only "$1" | sort | comm -12 - "$tmp/paths" > "$tmp/there"
  PUT_ABSENT="$(comm -23 "$tmp/paths" "$tmp/there")"
  [ -s "$tmp/there" ] || return 0
  # shellcheck disable=SC2046
  git -C "$dir" archive "$1" $(cat "$tmp/there") | tar -x -C "$2"
}
# newline <commit> — a file the commit changes must end with a line feed: the store keeps lines
newline() {
  local f
  while IFS= read -r f; do
    [ -z "$(git -C "$dir" cat-file blob "$1:$f" | tail -c1)" ] \
      || die "$f, as commit $(git -C "$dir" rev-parse --short "$1") has it, does not end with a line feed, which the store cannot keep; end its last line"
  done < <(git -C "$dir" diff --name-only --no-renames --diff-filter=AM "$1^" "$1")
}
# since <p> — the values the base descends from at which the store has <p>, earliest first
since() {
  local vn vp vc
  while read -r vn vp vc; do
    [ "$vc" != "$t" ] && is_anc "$vc" "$t" && [ -d "$VIEW/.orthant/data/$1/$vn" ] || continue
    echo "$(g rev-list --count "$vc..$t") $vn"
  done < <(store_values "$VIEW/.orthant/config.tel") | sort -rn | awk '{ print $2 }'
}

wrote=0 dirty=0
[ "${#remove[@]}" -eq 0 ] && [ "${#obsolete[@]}" -eq 0 ] || dirty=1
for i in "${!names[@]}"; do
  p="${names[$i]}"; c="${commits[$i]}"
  if [ "${kind[$p]}" = keep ] && [ "$dirty" = 0 ]; then continue; fi
  if [ "${kind[$p]}" = new ]; then store_add_patch "$p" "${after[$p]}"; fi
  newline "$c"
  content "$c" "$tmp/want"
  where="$v"
  if [ "${kind[$p]}" = revise ]; then
    stored=0
    for a in $(since "$p"); do
      if store_put "$p" "$v" "$tmp/want" --since "$a"; then stored=1; where="$a"; break; fi
    done
    if [ "$stored" = 0 ]; then
      store_put_or_die "$p" "$v" "$tmp/want"
      [ -z "$(since "$p")" ] || warn "$p: the change fits no earlier commit, so it is checked in at $(g rev-parse --short "$t") alone"
    fi
    # lines of history which have the patch, and which the check-in did not reach
    wc="$(store_values "$VIEW/.orthant/config.tel" | awk -v n="$where" '$1 == n { print $3 }')"
    behind=()
    while read -r vn vp vc; do
      [ -d "$VIEW/.orthant/data/$p/$vn" ] && ! is_anc "$wc" "$vc" && ! is_anc "$vc" "$wc" || continue
      behind+=("$(g rev-parse --short "$vc")")
    done < <(store_values "$VIEW/.orthant/config.tel")
    if [ "${#behind[@]}" -gt 0 ]; then
      warn "$p: the patch as it is at ${behind[*]} is on another line of history, and still carries the old change; make it there too (bin/proscala-tree <commit>, then export --revise)"
    fi
  else
    store_put_or_die "$p" "$v" "$tmp/want"
  fi
  if [ "$PUT_COUNT" -gt 0 ]; then
    dirty=1
    if [ "${kind[$p]}" != keep ]; then
      note "$p: ${kind[$p]} — checked in at $(g rev-parse --short "$(store_values "$VIEW/.orthant/config.tel" | awk -v n="$where" '$1 == n { print $3 }')")"
      wrote=$((wrote + 1))
    fi
  fi
done

# --- prove it ------------------------------------------------------------------------
store_derive "$t" "$tmp/proof"
# A patch which is as its commit has it, yet stale, has been seen to: the commit
# says what it should be here. It is confirmed, and is stale no longer.
confirmed=0
while IFS=$'\t' read -r p st _; do
  [ "$st" = stale ] && [ -n "${seen[$p]:-}" ] || continue
  [ "${STORE_POST[$p]}" = "$(git -C "$dir" rev-parse "${commit_of[$p]}^{tree}")" ] || continue
  store_confirm "$p" "$v"
  note "$p: confirmed as it stands at $(g rev-parse --short "$t")"
  confirmed=$((confirmed + 1)); dirty=1
done < "$tmp/proof"
if [ "$confirmed" -gt 0 ]; then store_derive "$t" "$tmp/proof"; fi
still="$(awk -F'\t' '$2 == "stale" { print $1 }' "$tmp/proof" | tr '\n' ' ')"
[ -z "$still" ] || warn "still stale at $(g rev-parse --short "$t") after the export: $still"
if [ "$STORE_TREE" != "$(git -C "$dir" rev-parse 'HEAD^{tree}')" ]; then
  g diff --stat "$(git -C "$dir" rev-parse 'HEAD^{tree}')" "$STORE_TREE" | sed 's/^/   /' | head -20 >&2
  die "deriving the patches at $(g rev-parse --short "$t") anew would not rebuild the tree exactly; nothing written"
fi
for i in "${!names[@]}"; do
  p="${names[$i]}"
  [ "${STORE_POST[$p]}" = "$(git -C "$dir" rev-parse "${commits[$i]}^{tree}")" ] \
    || die "the store would not have $p as the tree's commit ${seen[$p]} has it; nothing written"
done

# --- write -----------------------------------------------------------------------------
if [ "$dirty" = 1 ]; then store_save; fi
for i in "${!names[@]}"; do
  p="${names[$i]}"; c="${commits[$i]}"
  cp "$P/$p/message" "$tmp/message" 2>/dev/null || : > "$tmp/message"
  write_message "$p" "$dir" "$c"
  if ! cmp -s "$tmp/message" "$P/$p/message"; then
    note "$p: wrote patches/$p/message"
    [ "${kind[$p]}" != keep ] || wrote=$((wrote + 1))
  fi
  manifest_set "$dir" "$p" "$(diff_id "$c^" "$c")" "$(payload_id "$c^" "$c")"
done
for p in ${obsolete[@]+"${obsolete[@]}"}; do note "$p: obsolete from $(g rev-parse --short "$t") on"; done
for p in ${remove[@]+"${remove[@]}"}; do
  rm -rf "${P:?}/$p"
  note "$p: removed"
done
printf '%s\n' "$t" > "$(gitdir_of "$dir")/proscala-target"
finished=1

note "$wrote patch$([ "$wrote" = 1 ] || echo es) written for scala/scala3 $(g rev-parse --short "$t"); review with git diff, then commit"
