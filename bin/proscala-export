#!/usr/bin/env bash
#
# proscala-export — write a tree's patches back to patches/.
#
# Usage:
#   bin/proscala-export [<dir>|<target>] [--adapt | --revise] [--obsolete <patch>]... [--remove <patch>]...
#
# Reads the commits above the tree's upstream base (one per patch, each with a
# `Proscala-Patch: <name>` trailer) in <dir>, or in worktrees/<target>, and
# records every patch whose commit differs from the version that was applied, as
# a version anchored at the tree's base. What that means depends on the change:
#
#   only context      (the patch's own +/- lines are unchanged: the tree was
#                      rebased, or a three-way merge placed it): recorded at once
#   a new patch       recorded at once, and added to patches/series
#   anything else     you must say which it is:
#     --adapt         this upstream needed the patch done differently; other
#                     versions stay as they are
#     --revise        the patch itself changed (a fix, a feature): the new
#                     version gets the next revision, and every older version
#                     is brought up to it by a three-way merge where that
#                     succeeds; those it cannot update are listed, and stay in
#                     use (behind) until someone updates them
#
#   --obsolete <p>    the tree no longer carries <p> because upstream has made it
#                     unnecessary: <p> gets `obsolete-from <base>`
#   --remove <p>      delete <p> and all its versions
#
# A patch the target should carry but the tree lacks is an error unless named in
# --obsolete or --remove. Before writing anything, the result is proved: choosing
# patches for the base anew must rebuild the tree exactly. Nothing is committed.

set -euo pipefail
PROSCALA_PROG=proscala-export
# shellcheck source=proscala-lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/proscala-lib.sh"

arg="" mode="" obsolete=() remove=()
while [ $# -gt 0 ]; do
  case "$1" in
    --adapt)    mode=adapt; shift ;;
    --revise)   mode=revise; shift ;;
    --obsolete) [ -n "${2:-}" ] || die "--obsolete needs a patch name"; obsolete+=("$2"); shift 2 ;;
    --remove)   [ -n "${2:-}" ] || die "--remove needs a patch name"; remove+=("$2"); shift 2 ;;
    -h|--help)  sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option $1" ;;
    *)  [ -z "$arg" ] || die "too many arguments"; arg="$1"; shift ;;
  esac
done
[ -n "$arg" ] || die "which tree? give its directory or its target"
if [ -d "$arg" ]; then dir="$(cd "$arg" && pwd)"; else dir="$PROSCALA_ROOT/worktrees/$(printf '%s' "$arg" | tr '/:' '__')"; fi
[ -d "$dir" ] || die "no tree at $dir (bin/proscala-tree makes one)"
op="$(in_progress "$dir")"
[ -z "$op" ] || die "$dir is mid-operation ($op); finish it first"
[ -z "$(git -C "$dir" status --porcelain --untracked-files=no)" ] \
  || die "$dir has uncommitted changes; commit them (with a Proscala-Patch trailer) first"

t="$(tree_base "$dir")"
recorded="$(tree_target "$dir")"
if [ -n "$recorded" ] && [ "$recorded" != "$t" ]; then
  note "the tree has moved from scala/scala3 $(g rev-parse --short "$recorded") to $(g rev-parse --short "$t")"
fi
profile="$(tree_profile "$dir")"
if is_stream "$profile" && [ "$(upstream_sha "$profile")" != "$t" ]; then
  warn "the tree is the $profile stream, but mk/$profile.mk pins $(upstream_sha "$profile" | cut -c1-10), not $(g rev-parse --short "$t"): update UPSTREAM_SHA too"
fi

tmp="$(mktemp -d "${TMPDIR:-/tmp}/proscala-export.XXXXXX")"
trap 'rm -rf "$tmp"; if [ -n "${SELECT_INDEX:-}" ]; then rm -f "$SELECT_INDEX"; fi' EXIT

# --- read the tree -------------------------------------------------------------
names=() commits=()
declare -A seen=() dropping=()
for p in ${obsolete[@]+"${obsolete[@]}"} ${remove[@]+"${remove[@]}"}; do dropping[$p]=1; done
while IFS= read -r c; do
  short="$(git -C "$dir" rev-parse --short "$c")"
  [ "$(git -C "$dir" rev-list --parents -n1 "$c" | wc -w)" -eq 2 ] \
    || die "commit $short is a merge; a patch must be a single ordinary commit"
  p="$(commit_patch_name "$dir" "$c")"
  [[ "$p" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "commit $short: '$p' is not a valid patch name (lower-case letters and digits, hyphen-separated)"
  [ "$p" != series ] || die "commit $short: 'series' is a reserved name"
  [ -z "${seen[$p]:-}" ] || die "two commits are both patch '$p' ($short and ${seen[$p]}); squash them into one"
  [ -z "${dropping[$p]:-}" ] || die "the tree still has a commit for '$p', which you asked to drop"
  [ "$(git -C "$dir" log -1 --format=%B "$c" | grep -cx -- '---')" -eq 0 ] \
    || die "commit $short ($p): its message has a line that is just '---', which 'git am' would cut the message at"
  seen[$p]="$short"
  names+=("$p"); commits+=("$c")
done < <(git -C "$dir" rev-list --reverse "$t..HEAD")
[ "${#names[@]}" -gt 0 ] || die "$dir has no patch commits above $t"

# The tree's order must agree with patches/series; new patches slot in where they are.
known=() ; for p in "${names[@]}"; do if in_series "$p"; then known+=("$p"); fi; done
want="$(for p in $(series); do if [ -n "${seen[$p]:-}" ]; then echo "$p"; fi; done)"
[ "$want" = "$(printf '%s\n' ${known[@]+"${known[@]}"})" ] \
  || die "the tree applies patches in a different order from patches/series; reorder patches/series by hand (it is shared by every target) or the tree"
declare -A removing=()
for p in ${remove[@]+"${remove[@]}"}; do removing[$p]=1; done
# newafter <p> — the tree's new patches that follow <p>, up to the next known one
newafter() {
  local i started=0
  for i in "${!names[@]}"; do
    if [ "$started" = 1 ]; then
      if in_series "${names[$i]}"; then break; fi
      echo "${names[$i]}"
    elif [ "${names[$i]}" = "$1" ]; then started=1; fi
  done
  return 0
}
{
  awk 'NR == 1, /^$/' "$P/series"          # the header comment
  for p in $(series); do
    if [ -n "${removing[$p]:-}" ]; then continue; fi
    echo "$p"
    newafter "$p"
  done
} > "$tmp/series"
for p in "${names[@]}"; do grep -qx -- "$p" "$tmp/series" || die "cannot place new patch '$p' in the series (put a known patch before it in the tree)"; done

# --- what the target should carry ------------------------------------------------
select_plan "$t" "$tmp/expect"; rm -f "$SELECT_INDEX"; SELECT_INDEX=""
while IFS=$'\t' read -r p st _ detail; do
  case "$st" in
    plain|3way|missing)
      [ -n "${seen[$p]:-}" ] || [ -n "${dropping[$p]:-}" ] \
        || die "the target should carry '$p' but the tree has no commit for it (--obsolete $p if upstream made it unnecessary, --remove $p to delete it)" ;;
    out)
      [ -z "${seen[$p]:-}" ] || die "the tree carries '$p', but its bounds exclude this target ($detail); change patches/$p/meta first" ;;
  esac
done < "$tmp/expect"

# --- decide ----------------------------------------------------------------------
declare -A dest=() kind=() srcfile=()
stale=() unmarked=()
for i in "${!names[@]}"; do
  p="${names[$i]}"; f="$tmp/$p.patch"
  export_commit "$dir" "${commits[$i]}" > "$f"
  nid="$(patch_id "$f")"
  mid="$(manifest_field "$dir" "$p" 2)"
  mfile="$(manifest_field "$dir" "$p" 3)"; [ -z "$mfile" ] || mfile="$PROSCALA_ROOT/$mfile"
  srcfile[$p]="$mfile"
  if [ -n "$mid" ] && [ "$nid" = "$mid" ]; then
    kind[$p]=keep
    if [ -n "$mfile" ] && { [ ! -f "$mfile" ] || [ "$(patch_id "$mfile")" != "$mid" ]; }; then stale+=("$p"); fi
    continue
  fi
  if ! in_series "$p"; then kind[$p]=new
  elif [ -n "$mfile" ] && [ -f "$mfile" ] && [ "$(payload_id "$f")" = "$(payload_id "$mfile")" ]; then kind[$p]=context
  else
    case "$mode" in
      adapt|revise) kind[$p]="$mode" ;;
      *) unmarked+=("$p") ;;
    esac
  fi
done
if [ "${#stale[@]}" -gt 0 ]; then
  die "$dir is out of date: ${stale[*]} changed in patches/ since it was built, and exporting it would undo that. Rebuild it (bin/proscala-tree <target> --reset refuses if it holds unexported work)."
fi
if [ "${#unmarked[@]}" -gt 0 ]; then
  die "the change to ${unmarked[*]} is more than context. Export again with --adapt (this upstream needs the patch done differently) or --revise (the patch itself changed)."
fi

# where each changed patch goes: an identical existing version gains this anchor;
# otherwise the version anchored here is (re)written
vname="$(variant_name "$t")"
for p in "${names[@]}"; do
  case "${kind[$p]}" in keep) continue ;; esac
  dest[$p]="$P/$p/$vname"
  for v in "$P/$p"/*.patch; do
    if [ -f "$v" ] && cmp -s "$v" "$tmp/$p.patch"; then dest[$p]="$v"; break; fi
  done
done

# --- prove it ------------------------------------------------------------------------
force=()
for p in "${names[@]}"; do
  if [ "${kind[$p]}" != keep ]; then force+=("$p=$tmp/$p.patch"); fi
done
PROSCALA_SERIES="$tmp/series" select_plan "$t" "$tmp/proof" ${force[@]+"${force[@]}"}
got="$(GIT_INDEX_FILE="$SELECT_INDEX" g write-tree)"; rm -f "$SELECT_INDEX"; SELECT_INDEX=""
if [ "$got" != "$(git -C "$dir" rev-parse 'HEAD^{tree}')" ]; then
  awk -F'\t' '$2 != "out" { print "   " $1 "\t" $2 }' "$tmp/proof" >&2
  die "choosing patches for $(g rev-parse --short "$t") anew would not rebuild the tree exactly (an unchanged patch now selects a different version?); nothing written"
fi

# --- write -----------------------------------------------------------------------------
wrote=0
cp "$tmp/series" "$P/series"
for i in "${!names[@]}"; do
  p="${names[$i]}"
  case "${kind[$p]}" in keep) continue ;; esac
  src="${srcfile[$p]}"
  srcrev="$(if [ -n "$src" ]; then variant_line "$p" "$(basename "$src")" | awk '{ print $2 }'; fi)"
  case "${kind[$p]}" in
    new)      rev=1 ;;
    context)  rev="${srcrev:-1}" ;;
    adapt)    rev="${srcrev:-$(max_revision "$p")}" ;;
    revise)   rev="$(( $(max_revision "$p") + 1 ))" ;;
  esac
  [ "$rev" -ge 1 ] 2>/dev/null || rev=1
  d="${dest[$p]}"; dn="$(basename "$d")"
  mkdir -p "$P/$p"
  if [ -f "$d" ] && cmp -s "$d" "$tmp/$p.patch"; then
    # an identical version exists: it now also applies here
    line="$(variant_line "$p" "$dn")"
    set_variant "$p" "$dn" "$(echo "$line" | awk '{ print $2 }')" $(echo "$line" | cut -d' ' -f3-) "$t"
    note "$p: the existing version $dn also applies at $(g rev-parse --short "$t")"
  else
    # Rewriting a version anchored elsewhere too: it keeps each other anchor where
    # the new content still applies; where it does not, the old content stays, as
    # a version of its own.
    keep=() orphan=()
    if [ -f "$d" ]; then
      oldline="$(variant_line "$p" "$dn")"
      for a in $(echo "$oldline" | cut -d' ' -f3-); do
        [ "$a" = "$t" ] && continue
        select_plan "$a" "$tmp/other" "$p=$tmp/$p.patch"; rm -f "$SELECT_INDEX"; SELECT_INDEX=""
        if [ "$(awk -F'\t' -v p="$p" '$1 == p { print $2 }' "$tmp/other")" = plain ]; then keep+=("$a"); else orphan+=("$a"); fi
      done
      if [ "${#orphan[@]}" -gt 0 ]; then
        on="$(variant_name "${orphan[0]}")"
        [ "$on" != "$dn" ] && [ ! -e "$P/$p/$on" ] || die "$p: cannot keep the old version for ${orphan[*]}: $on is taken"
        cp "$d" "$P/$p/$on"
        set_variant "$p" "$on" "$(echo "$oldline" | awk '{ print $2 }')" "${orphan[@]}"
        note "$p: the old content stays as $on for $(for a in "${orphan[@]}"; do g rev-parse --short "$a"; done | tr '\n' ' ')"
      fi
    fi
    cp "$tmp/$p.patch" "$d"
    set_variant "$p" "$dn" "$rev" "$t" ${keep[@]+"${keep[@]}"}
    note "$p: ${kind[$p]} — wrote ${d#"$PROSCALA_ROOT"/} (revision $rev)"
  fi
  manifest_set "$dir" "$p" "$(patch_id "$d")" "$d"
  wrote=$((wrote + 1))
done
for p in ${obsolete[@]+"${obsolete[@]}"}; do
  add_bound "$p" obsolete-from "$t" "dropped at $(g rev-parse --short "$t") by proscala-export: upstream made it unnecessary"
  note "$p: obsolete from $(g rev-parse --short "$t") on"
done
for p in ${remove[@]+"${remove[@]}"}; do
  [[ "$p" =~ ^[a-z0-9-]+$ ]] || die "bad patch name '$p'"
  g rm -rq --ignore-unmatch -- "patches/$p"
  note "$p: removed"
done

# --- carry a revision to the other versions ------------------------------------------------
for p in "${names[@]}"; do
  [ "${kind[$p]}" = revise ] || continue
  newrev="$(max_revision "$p")"; newfile="${dest[$p]}"
  behind=()
  while read -r vf vrev vanchors; do
    [ "$vrev" -lt "$newrev" ] || continue
    a="${vanchors%% *}"
    SELECT_TREES=1 SELECT_3WAY=1 select_plan "$a" "$tmp/carry" "$p=$newfile"
    rm -f "$SELECT_INDEX"; SELECT_INDEX=""
    st="$(awk -F'\t' -v p="$p" '$1 == p { print $2 }' "$tmp/carry")"
    if [ "$st" = plain ] || [ "$st" = 3way ]; then
      c="$(commit_from_trees "${SELECT_PRE[$p]}" "${SELECT_POST[$p]}" "$newfile")"
      export_commit "$PROSCALA_ROOT" "$c" > "$P/$p/$vf"
      set_variant "$p" "$vf" "$newrev" "$a"
      note "$p: brought $vf (at $(g rev-parse --short "$a")) up to revision $newrev"
    else
      behind+=("$vf@$(g rev-parse --short "$a")")
    fi
  done < <(variants "$p")
  if [ "${#behind[@]}" -gt 0 ]; then
    warn "$p: ${behind[*]} could not be brought up to revision $newrev mechanically, and still carry the old change; update them by hand (bin/proscala-tree <anchor>, then export --revise)"
  fi
done

note "$wrote patch file$([ "$wrote" = 1 ] || echo s) written for scala/scala3 $(g rev-parse --short "$t"); review with git diff, then commit"
