#!/usr/bin/env bash
#
# proscala-buildconf — write the build config for an arbitrary scala/scala3 tree.
#
# Usage (bin/proscala-tree runs it for every target that is not a stream):
#   bin/proscala-buildconf <dir>          # writes <dir>/mk/target.mk, prints its profile
#
# A stream's build config is mk/<stream>.mk, chosen by hand and tested. Any other
# tree gets mk/target.mk, which includes the stream config whose module layout
# matches the tree — 3.10 when it carries the scala3-directives-parser module,
# else 3.9 — and then overrides, from the tree's own sbt build, what decides
# whether it compiles at all:
#
#   VERSION               <upstream baseVersion>-bin-<commit>-propensive
#   REF_VERSION           upstream's referenceVersion (project/*.scala)
#   BASE_SCALAJS_VERSION  the sbt-scalajs version (project/plugins.sbt)
#   ASM                   shaded scala-asm or org.ow2.asm, at upstream's version,
#                         for the tree; and for the reference compiler, whatever
#                         its published POM depends on
#
# Every other version (jline, guava, …) stays at the matched stream's value.
# A -propensive version can never be published (mk/publish.mk refuses it).

set -euo pipefail
PROSCALA_PROG=proscala-buildconf
# shellcheck source=proscala-lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/proscala-lib.sh"

dir="${1:-}"
[ -n "$dir" ] && [ -d "$dir/project" ] || die "usage: proscala-buildconf <scala3 tree>"
cd "$dir"

scalaval() { # scalaval <name> — a `val <name> = "…"` from the sbt build, with $vars expanded
  local v
  v="$(grep -h -E "val $1 *= *s?\"" project/*.scala 2>/dev/null | head -1 | sed -E 's/.*= *s?"([^"]*)".*/\1/')"
  while [[ "$v" =~ \$\{?([A-Za-z]+)\}? ]]; do
    v="${v/${BASH_REMATCH[0]}/$(scalaval "${BASH_REMATCH[1]}")}"
  done
  printf '%s' "$v"
}

base=3.9; [ -d directives-parser/src/main/scala ] && base=3.10
ref="$(scalaval referenceVersion)";  [ -n "$ref" ] || die "no referenceVersion in $dir/project"
upver="$(scalaval baseVersion)";     [ -n "$upver" ] || die "no baseVersion in $dir/project"
sjs="$(sed -nE 's/.*"sbt-scalajs" *% *"([^"]+)".*/\1/p' project/plugins.sbt | head -1)"
[ -n "$sjs" ] || die "no sbt-scalajs version in $dir/project/plugins.sbt"
commit="$(git rev-parse --short=7 "$(tree_base .)")"

# the tree's own ASM
tree_shaded="$(grep -h -E '"org.scala-lang.modules" *% *"scala-asm" *% *"' project/*.scala | head -1 | sed -E 's/.*"scala-asm" *% *"([^"]+)".*/\1/' || true)"
tree_ow2="$(grep -h -E '"org.ow2.asm" *% *"asm-util" *% *"' project/*.scala | head -1 | sed -E 's/.*"asm-util" *% *"([^"]+)".*/\1/' || true)"
[ -n "$tree_shaded" ] || [ -n "$tree_ow2" ] || die "cannot tell which ASM the tree's sbt build uses"

# the reference compiler's ASM, from its POM
pom="$(curl -fsSL "https://repo1.maven.org/maven2/org/scala-lang/scala3-compiler_3/$ref/scala3-compiler_3-$ref.pom")" \
  || die "cannot fetch the POM of the reference compiler $ref"
ref_shaded="$(printf '%s' "$pom" | awk '/<artifactId>scala-asm<\/artifactId>/ { f = 1; next } f && /<version>/ { gsub(/.*<version>|<\/version>.*/, ""); print; exit }')"
ref_ow2="$(printf '%s' "$pom" | awk '/<artifactId>asm-util<\/artifactId>/ { f = 1; next } f && /<version>/ { gsub(/.*<version>|<\/version>.*/, ""); print; exit }')"
[ -n "$ref_shaded" ] || [ -n "$ref_ow2" ] || die "cannot tell which ASM the reference compiler $ref depends on"

mkdir -p mk
{
  echo "# Generated by bin/proscala-buildconf for scala/scala3 $commit. Do not edit:"
  echo "# rebuild the tree (bin/proscala-tree) to regenerate it."
  echo "include \$(ROOT)/mk/$base.mk"
  echo
  echo "VERSION              := $upver-bin-$commit-propensive"
  echo "REF_VERSION          := $ref"
  echo "BASE_SCALAJS_VERSION := $sjs"
  echo
  echo "# The tree's own JVM backend"
  if [ -n "$tree_shaded" ]; then
    echo "ASM_VERSION          := $tree_shaded"
    echo "TREE_ASM_MAVEN_PATHS :="
    echo "TREE_ASM_JARS         = \$(ASM_JAR)"
    echo "TREE_ASM_COORDS      := org.scala-lang.modules:scala-asm:\$(ASM_VERSION)"
  else
    echo "TREE_ASM_VERSION     := $tree_ow2"
    echo "TREE_ASM_NAMES       := asm asm-tree asm-analysis asm-util asm-commons"
    echo "TREE_ASM_MAVEN_PATHS := \$(foreach n,\$(TREE_ASM_NAMES),org/ow2/asm/\$(n)/\$(TREE_ASM_VERSION)/\$(n)-\$(TREE_ASM_VERSION).jar)"
    echo "TREE_ASM_JARS        := \$(foreach n,\$(TREE_ASM_NAMES),\$(JARS)/\$(n)-\$(TREE_ASM_VERSION).jar)"
    echo "TREE_ASM_COORDS      := org.ow2.asm:asm-util:\$(TREE_ASM_VERSION) org.ow2.asm:asm-commons:\$(TREE_ASM_VERSION)"
  fi
  echo
  echo "# The reference compiler $ref (from its POM)"
  if [ -n "$ref_shaded" ]; then
    echo "REF_ASM_JARS         := scala-asm-$ref_shaded.jar"
    # the Makefile always fetches scala-asm at \$(ASM_VERSION); fetch another if needed
    if [ "$ref_shaded" != "${tree_shaded:-9.9.0-scala-1}" ]; then
      echo "EXTRA_MAVEN_PATHS    += org/scala-lang/modules/scala-asm/$ref_shaded/scala-asm-$ref_shaded.jar"
    fi
  else
    echo "REF_ASM_JARS         := \$(foreach n,asm asm-tree asm-analysis asm-util asm-commons,\$(n)-$ref_ow2.jar)"
    if [ "$ref_ow2" != "$tree_ow2" ]; then
      echo "EXTRA_MAVEN_PATHS    += \$(foreach n,asm asm-tree asm-analysis asm-util asm-commons,org/ow2/asm/\$(n)/$ref_ow2/\$(n)-$ref_ow2.jar)"
    fi
  fi
} > mk/target.mk
echo "$base $sjs"
