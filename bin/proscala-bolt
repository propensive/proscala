#!/usr/bin/env python3
#
# proscala-bolt — assign bolt codes to the compiler's messages.
#
# Usage:
#   bin/proscala-bolt <registry.tel> <tree>...           # assign codes to what is new
#   bin/proscala-bolt --check <registry.tel> <tree>...   # exit 1 if anything is unassigned
#   bin/proscala-bolt --keys <registry.tel>              # the code of each key, for the jar
#
# A bolt code names a diagnostic: `↯/p.1.7`. For Proscala (`p`) the first number
# is a subdivision of the compiler, the second a message in it:
#
#   1      the messages upstream numbers itself (`ErrorMessageID`): `E007` is `1.7`
#   2      general: `2.1` a message with no assignment, `2.2` one reported by a macro
#   3...   the messages upstream leaves unnumbered, by the part of the compiler
#          that reports them
#
# An unnumbered message is one made by the `em"..."` interpolator. It is known by
# its *template*: the constant parts of the interpolated string, joined by `{}`,
# with each run of whitespace collapsed to a space. The compiler computes the
# same key from the `StringContext` it is given (`reporting.BoltCodes`), and
# looks its code up in the registry, which the build puts in the compiler's jar.
#
# A message given to `report.error` or `report.warning` as a plain string has no
# `StringContext`, so it is known by its text instead: its key is `text:` and
# the text, with `{}` for each part of it the source does not fix, and the
# compiler finds the key its text fits. A message built in any other way cannot
# be found in the source, and is `2.1`.
#
# This tool reads the templates out of each tree's `compiler/src` and appends
# those the registry does not yet hold, each with the next free number of its
# subdivision. It never renumbers, reuses or removes: a code, once assigned, is
# permanent. When upstream rewords a message, its new template is a new error; to
# keep the old code instead, move the `template` line to the old error by hand
# (an error may have several).
#
# The registry is a TEL document of the `bolt` schema (`bolt.tel` in the `bolt`
# repository): `subdivision 7` / `error 40`, with a `template` or a `text` for
# each key and, for the reader only, the `source` file it was first seen in.
# This tool reads and writes the form it writes itself, not the whole of TEL.

import os
import re
import sys

AREAS = [
    (3, "driver", "command line, settings, classpath and everything not listed below"),
    (4, "parsing", "scanners and parsers"),
    (5, "ast", "trees and desugaring"),
    (6, "core", "symbols, types, classfile and TASTy readers"),
    (7, "typer", "naming, typing and checking"),
    (8, "metaprogramming", "inlining, quotes, splices and staging"),
    (9, "captures", "capture checking"),
    (10, "transform", "the transformation phases"),
    (11, "backend", "the JVM backend"),
    (12, "scalajs", "the Scala.js and WebAssembly phases and backends"),
]

GENERAL = [
    ("2", "general", "messages with no subdivision of their own"),
    ("2.1", "Unassigned", "a message with no bolt code of its own"),
    ("2.2", "Macro", "a message reported by a macro; carries the macro's own bolt code, if it gave one"),
]

SOURCE = "compiler/src/dotty/tools"
SPACE = re.compile(r"[ \t\r\n\f]+")
IDENT_START = re.compile(r"[A-Za-z_]")
IDENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")


def area(path):
    """The subdivision for a file, by its path under compiler/src/dotty/tools."""
    parts = path.split("/")
    if "sjs" in parts or "wasm" in parts:
        return 12
    if parts[0] == "backend":
        return 11
    if parts[0] != "dotc" or len(parts) < 3:
        return 3
    return {
        "parsing": 4, "ast": 5, "core": 6, "typer": 7, "inlines": 8, "quoted": 8,
        "staging": 8, "cc": 9, "transform": 10,
    }.get(parts[1], 3)


def skip_code(text, at):
    """The index after a `{...}` block of Scala code beginning at `at` (a `{`)."""
    depth = 0
    while at < len(text):
        char = text[at]
        if char == "{":
            depth += 1
            at += 1
        elif char == "}":
            depth -= 1
            at += 1
            if depth == 0:
                return at
        elif char == '"':
            start = at
            while start > 0 and (text[start - 1].isalnum() or text[start - 1] == "_"):
                start -= 1
            _, at = read_string(text, at, interpolated=start < at)
        elif char == "'" and at + 2 < len(text) and (text[at + 2] == "'" or text[at + 1] == "\\"):
            at = text.index("'", at + 2) + 1
        elif text.startswith("//", at):
            end = text.find("\n", at)
            at = len(text) if end < 0 else end
        elif text.startswith("/*", at):
            end = text.find("*/", at)
            at = len(text) if end < 0 else end + 2
        else:
            at += 1
    return at


def read_string(text, at, interpolated):
    """The parts of the string literal opening at `at` (a `"`), and the index after it."""
    triple = text.startswith('"""', at)
    at += 3 if triple else 1
    parts, part = [], []
    while at < len(text):
        char = text[at]
        if triple and text.startswith('"""', at):
            at += 3
            while at < len(text) and text[at] == '"':
                part.append('"')
                at += 1
            break
        if not triple and char == '"':
            at += 1
            break
        if not triple and char == "\\" and at + 1 < len(text):
            part.append(text[at:at + 2])
            at += 2
        elif interpolated and char == "$":
            following = text[at + 1] if at + 1 < len(text) else ""
            if following == "$" or (following == '"' and not triple):
                part.append(following)
                at += 2
            elif following == "{":
                parts.append("".join(part))
                part = []
                at = skip_code(text, at + 1)
            elif IDENT_START.match(following):
                parts.append("".join(part))
                part = []
                at = IDENT.match(text, at + 1).end()
            else:
                part.append(char)
                at += 1
        else:
            part.append(char)
            at += 1
    parts.append("".join(part))
    return parts, at


def key_of(parts):
    return SPACE.sub(" ", "{}".join(parts)).strip()


ESCAPES = {"n": "\n", "t": "\t", '"': '"', "\\": "\\", "'": "'", "r": "\r", "f": "\f", "b": "\b"}
PLAIN = re.compile(r'(?<![A-Za-z0-9_.])report\s*\.\s*(?:error|warning)\(\s*([is]?)"')


def text_key(parts, prefix, triple, continued, margin=False):
    """The key of a message given as a plain string: the text the compiler will
    see, with `{}` wherever it cannot be known from the source."""
    def unescape(part):
        return re.sub(r"\\(.)", lambda found: ESCAPES.get(found.group(1), found.group(0)), part)

    if prefix == "i" or margin:
        parts = [re.sub(r"\n[ \t]*\|", "\n", part) for part in parts]
        parts[0] = re.sub(r"^[ \t]*\|", "", parts[0])
        parts = parts[:1] + [re.sub(r"^%[^%]*%", "", part) for part in parts[1:]]
    if not triple:
        parts = [unescape(part) for part in parts]
    if continued:
        parts = parts + [""]
    return key_of(parts)


def templates(text):
    """The key of every message in a source file, in order: of each `em"..."`,
    and (as `text:...`) of each string given directly to `report.error` or
    `report.warning`."""
    found = []
    for match in re.finditer(r'(?<![A-Za-z0-9_])em"', text):
        parts, _ = read_string(text, match.end() - 1, interpolated=True)
        key = key_of(parts)
        if re.search(r"[A-Za-z]", key.replace("{}", "")):
            found.append((match.start(), key))
    for match in PLAIN.finditer(text):
        at = match.end() - 1
        parts, end = read_string(text, at, interpolated=match.group(1) != "")
        margin = re.match(r"\s*\.stripMargin\b", text[end:])
        if margin:
            end += margin.end()
        following = re.match(r"\s*(.)", text[end:], re.S)
        continued = following is not None and following.group(1) not in ",)"
        key = text_key(parts, match.group(1), text.startswith('"""', at), continued, margin is not None)
        constant = key.replace("{}", "")
        if re.search(r"[A-Za-z]", constant) and ("{}" not in key or len(constant.strip()) >= 8):
            found.append((match.start(), "text:" + key))
    return [key for _, key in sorted(found)]


LEVELS = ["subdivision", "error", "variant", "site"]
PRAGMA = "tel 1.0 propensive.dev/bolt"


def phrases(content):
    """The phrases of a TEL line: separated by any space until the first run of
    two or more, and from there only by such runs. A `#` which begins a phrase
    and is followed by one space begins a remark."""
    found, at, hard = [], 0, False
    while at < len(content):
        if content.startswith("# ", at) and not content.startswith("#  ", at) and found:
            break
        gap = re.compile(r" {2,}" if hard else r" +").search(content, at)
        if not hard and gap and len(gap.group(0)) < 2:
            run = re.compile(r" {2,}").search(content, at)
            if run and run.start() == gap.start():
                gap = run
        end = gap.start() if gap else len(content)
        found.append(content[at:end])
        if gap and len(gap.group(0)) >= 2:
            hard = True
        at = gap.end() if gap else len(content)
    return found


def read_registry(path):
    """The registry's rows — code, state, name, origin, key — from its TEL: one
    for each key of a code, or one without a key."""
    records = []
    if not os.path.exists(path):
        return []
    with open(path, encoding="utf-8") as file:
        lines = file.read().split("\n")
    stack = []  # (indent, keyword, record or None, code)
    index, previous = 0, None
    while index < len(lines):
        line = lines[index]
        index += 1
        if not line.strip(" "):
            previous = None
            continue
        indent = (len(line) - len(line.lstrip(" "))) // 2
        words = phrases(line.strip(" "))
        keyword, atoms = words[0], words[1:]
        if keyword == "#" or (keyword == "tel" and not records and not stack):
            continue
        if previous is not None and indent == previous + 2:
            # a source atom: the value of the line above, verbatim
            text = [line.strip()]
            while index < len(lines) and (not lines[index].strip(" ") or
                                          len(lines[index]) - len(lines[index].lstrip(" ")) >= indent * 2):
                text.append(lines[index].strip())
                index += 1
            atoms, indent, keyword = ["\n".join(text).strip()], previous, stack[-1][1]
            stack.pop()
        while stack and stack[-1][0] >= indent:
            stack.pop()
        parent = stack[-1] if stack else None
        record = None
        code = parent[3] if parent else ""
        if keyword == "project":
            code = ""
        elif keyword in LEVELS:
            if not atoms:
                sys.exit(f"proscala-bolt: {path}:{index}: a {keyword} needs its number")
            code = (code + "." if code else "") + atoms[0]
            record = {"code": code, "state": "active", "name": "-", "origin": "", "keys": []}
            if len(atoms) > 1:
                record["name"] = atoms[1]
            if "retired" in atoms[2:]:
                record["state"] = "retired"
            records.append(record)
        elif parent and parent[2] is not None:
            owner, value = parent[2], atoms[0] if atoms else ""
            if keyword == "retired":
                owner["state"] = "retired"
            elif keyword == "name" and value:
                owner["name"] = value
            elif keyword in ("description", "source") and value:
                owner["origin"] = value
            elif keyword == "template" and value:
                owner["keys"].append(value)
            elif keyword == "text" and value:
                owner["keys"].append("text:" + value)
        stack.append((indent, keyword, record, code))
        previous = indent
    rows = []
    for record in records:
        for key in record["keys"] or [""]:
            rows.append([record["code"], record["state"], record["name"], record["origin"], key])
    return rows


def write_registry(path, rows):
    def order(row):
        return [int(number) for number in row[0].split(".")]

    def value(keyword, text, depth):
        # After two spaces a value may contain single ones; one which could be
        # misread is written on a line of its own, as a source atom.
        pad = "  " * depth
        if "  " in text or "\n" in text or text.startswith("# ") or text != text.strip():
            return [f"{pad}{keyword}", f"{pad}    {text}"]
        return [f"{pad}{keyword}  {text}" if " " in text else f"{pad}{keyword} {text}"]

    merged = {}
    for row in sorted(rows, key=order):
        entry = merged.setdefault(row[0], {"state": row[1], "name": row[2], "origin": row[3], "keys": []})
        if row[1] == "retired":
            entry["state"] = "retired"
        if row[4]:
            entry["keys"].append(row[4])

    out = [PRAGMA, "",
           "# Bolt codes of Proscala: `subdivision 1` / `error 7` is ↯/p.1.7.",
           "# Maintained by Proscala's bin/proscala-bolt.", "",
           "project p proscala"]
    for code, entry in merged.items():
        depth = len(code.split("."))
        pad = "  " * depth
        if depth == 1:
            out.append("")
        head = f"{pad}{LEVELS[depth - 1]} {code.split('.')[-1]}"
        named = entry["name"] not in ("", "-")
        if named:
            head += " " + entry["name"]
        if entry["state"] == "retired" and named:
            head += " retired"
        out.append(head)
        if entry["state"] == "retired" and not named:
            out.append(f"{pad}  retired")
        if entry["origin"]:
            kind = "source" if entry["origin"].endswith(".scala") else "description"
            out += value(kind, entry["origin"], depth + 1)
        for key in [key for key in entry["keys"] if not key.startswith("text:")]:
            out += value("template", key, depth + 1)
        for key in [key for key in entry["keys"] if key.startswith("text:")]:
            out += value("text", key[len("text:"):], depth + 1)
    with open(path, "w", encoding="utf-8") as file:
        file.write("\n".join(out) + "\n")


def standard(tree):
    """Rows for upstream's own numbered messages, from its ErrorMessageID enum."""
    path = os.path.join(tree, SOURCE, "dotc/reporting/ErrorMessageID.scala")
    rows = []
    with open(path, encoding="utf-8") as file:
        number = -1
        for line in file:
            match = re.match(r"\s*case (\w+)ID\b(.*)", line)
            if match:
                if number > 0:
                    state = "retired" if "isActive = false" in match.group(2) else "active"
                    rows.append((f"1.{number}", state, match.group(1)))
                number += 1
    return rows


def main(arguments):
    if arguments[:1] == ["--keys"] and len(arguments) == 2:
        # what the compiler's jar holds: the code of each key
        for code, state, _, _, key in read_registry(arguments[1]):
            if key and state == "active":
                print(f"{code}\t{key}")
        return
    check = arguments[:1] == ["--check"]
    if check:
        arguments = arguments[1:]
    if len(arguments) < 2:
        sys.exit("usage: proscala-bolt [--check] <registry.tel> <tree>... | --keys <registry.tel>")
    registry, trees = arguments[0], arguments[1:]

    rows = read_registry(registry)
    codes = {row[0]: row for row in rows}
    keys = {row[4] for row in rows if row[4]}
    added = []

    def add(code, state, name, origin="", key=""):
        row = [code, state, name, origin, key]
        rows.append(row)
        codes.setdefault(code, row)
        added.append(row)

    if "1" not in codes:
        add("1", "active", "standard", "", "")
    for code, name, description in GENERAL:
        if code not in codes:
            add(code, "active", name, description)
    for number, name, description in AREAS:
        if str(number) not in codes:
            add(str(number), "active", name, description)

    last = {}
    for row in rows:
        numbers = row[0].split(".")
        if len(numbers) == 2:
            last[int(numbers[0])] = max(last.get(int(numbers[0]), 0), int(numbers[1]))

    for tree in trees:
        for code, state, name in standard(tree):
            if code not in codes:
                add(code, state, name)
            elif codes[code][2] != name:
                # Upstream renamed it; a renamed message keeps its code, under the name
                # the registry already has (give the newest tree first).
                print(f"proscala-bolt: note: {code} is {codes[code][2]} in the registry, {name} in {tree}")
            elif state == "retired" and codes[code][1] != "retired":
                codes[code][1] = "retired"
                added.append(codes[code])

        root = os.path.join(tree, SOURCE)
        files = []
        for directory, _, names in os.walk(root):
            files += [os.path.join(directory, name) for name in names if name.endswith(".scala")]
        for path in sorted(files):
            relative = os.path.relpath(path, root)
            with open(path, encoding="utf-8") as file:
                text = file.read()
            for key in templates(text):
                if key not in keys:
                    keys.add(key)
                    division = area(relative)
                    last[division] = last.get(division, 0) + 1
                    add(f"{division}.{last[division]}", "active", "-", relative, key)

    if check:
        for row in added:
            print("unassigned: " + "\t".join(row).rstrip("\t"))
        if added:
            print(f"proscala-bolt: {len(added)} messages have no bolt code in {registry}; assign them with\n"
                  f"  bin/proscala-bolt mk/bolt-codes.tel <tree>   (from the Proscala checkout)", file=sys.stderr)
        sys.exit(1 if added else 0)

    if added:
        write_registry(registry, rows)
    print(f"proscala-bolt: {len(added)} new or changed, {len(rows)} in {registry}")


if __name__ == "__main__":
    main(sys.argv[1:])
