diff --git a/compiler/src/dotty/tools/dotc/inlines/Inliner.scala b/compiler/src/dotty/tools/dotc/inlines/Inliner.scala
index 1d128da06f48b7acfbf0f425f793146c45d50ee2..e58037f3938232bd1c2541e84b6ba9df2bb453d8 100644
--- a/compiler/src/dotty/tools/dotc/inlines/Inliner.scala
+++ b/compiler/src/dotty/tools/dotc/inlines/Inliner.scala
@@ -331,10 +331,122 @@ class Inliner(val call: tpd.Tree)(using Context):
           dropNameArg(arg0)
     val argtpe = arg.tpe.dealiasKeepAnnots.translateFromRepeated(toArray = false)
     val argIsBottom = argtpe.isBottomTypeAfterErasure
+    // Under capture checking, upstream (#26989) gives a proxy the argument's type from
+    // Typer as an explicit type, which cc takes at face value, and the argument is
+    // checked only against it. But that type says nothing about capture sets, so every
+    // argument that captures anything was rejected, even where the call would compile
+    // without `inline`. Instead, a proxy's capture sets are inferred, and bounded by what
+    // its parameter declares:
+    //  - A closure's parameter and result types stay declared (`@declared`), so a result
+    //    that leaks a capability is still caught; its own capture set follows the
+    //    parameter's function type: inferred where that may capture anything (`=>`,
+    //    `?=>`; not a fresh `any`, which separation checking would see as hiding what the
+    //    closure captures), the declared set where there is one, empty for a pure
+    //    function. The same goes for a function in the closure's result.
+    //  - Any other argument's type is inferred, intersected with a declared bound on its
+    //    top-level capture set: the parameter's explicit set (`^{io}`, `^{}`), or empty
+    //    for a parameter of a pure type. A parameter that may capture anything (`^`, a
+    //    capability class, an inferred type argument) bounds nothing.
+    var proxyInferred = false
+    def proxyType(tp: Type): Type =
+      import cc.{isRetainsLike, isCapsAnyRef, retainedElementsRaw, derivesFromCapability, isArrayUnderStrictMut}
+      def declared(t: Type) = AnnotatedType(t, Annotations.Annotation(defn.DeclaredAnnot, arg.span))
+      def inferred(t: Type) = AnnotatedType(t, Annotations.Annotation(defn.InferredAnnot, arg.span))
+      def mayCaptureAny(ann: Annotations.Annotation) =
+        ann.symbol == defn.RetainsCapAnnot
+        || cc.RetainingAnnotation.fromAnnotation(ann).retainedType.retainedElementsRaw
+            .exists(_.isCapsAnyRef)
+
+      // Does `t`, as written, say anything about captures?
+      def mentionsCaptures(t: Type): Boolean =
+        new TypeAccumulator[Boolean]:
+          def apply(found: Boolean, t: Type) = found || (t match
+            case AnnotatedType(_, ann) if ann.symbol.isRetainsLike => true
+            case AnnotatedType(_, ann) if ann.symbol == defn.InferredAnnot => false
+            case t: TypeRef if t.symbol.isClass => t.derivesFromCapability
+            case t: TypeRef => apply(false, t.prefix)
+            case t: AppliedType if t.tycon.typeSymbol.isClass && t.derivesFromCapability => true
+            case _ => foldOver(false, t))
+        .apply(false, t)
+
+      // The parameter and result types of `f`, a function type (dealiased, with any
+      // capture set dropped), if it is one: what the closure's parameter declares for them
+      def formalParts(f: Type): Option[(List[Type], Type)] = f.dealiasKeepAnnots match
+        case AnnotatedType(parent, ann) if ann.symbol.isRetainsLike => formalParts(parent)
+        case f @ AppliedType(_, args) if defn.isFunctionType(f) => Some((args.init, args.last))
+        case f @ RefinedType(_, nme.apply, mt: MethodType)
+        if defn.isFunctionType(f) && !mt.isParamDependent && !mt.isResultDependent =>
+          Some((mt.paramInfos, mt.resType))
+        case _ => None
+
+      // `t`, a function type, with its own capture set inferred and its parts declared:
+      // its parameters as `f`, the parameter's function type, declares them (with the
+      // call's inferred type arguments marked inferred), where the two line up
+      def inferredFunction(t: Type, f: Type): Type =
+        val (fparams, fres) = formalParts(f).getOrElse((Nil, NoType))
+        // A parameter is declared where its type says something about captures (`T^`, a
+        // capability class): that is what catches a closure leaking its parameter. One
+        // that says nothing (a type member, an inferred type argument) is inferred, rather
+        // than declared from a capture-free Typer type that would give an array a root.
+        def params(ps: List[Type]) =
+          (if fparams.length == ps.length then fparams else ps).map: p =>
+            if mentionsCaptures(p) then declared(p) else p
+        t match
+          case t @ RefinedType(parent, nme.apply, mt: MethodType) if defn.isFunctionType(t) =>
+            val ps = if mt.isParamDependent then mt.paramInfos.map(declared) else params(mt.paramInfos)
+            inferred(t.derivedRefinedType(parent, nme.apply,
+              mt.derivedLambdaType(mt.paramNames, ps, part(mt.resType, fres))))
+          case t @ AppliedType(tycon, args) if defn.isFunctionType(t) =>
+            inferred(t.derivedAppliedType(tycon, params(args.init) :+ part(args.last, fres)))
+          case _ => NoType
+
+      def part(t: Type, f: Type): Type = t.dealiasKeepAnnots match
+        case AnnotatedType(parent, ann) if ann.symbol.isRetainsLike && mayCaptureAny(ann) =>
+          inferredFunction(parent.dealias, f).orElse(declared(t))
+        case _ => declared(t)
+
+      // A declared bound on the top-level capture set of an argument for `formal`
+      def topBound(formal: Type): Type = formal.dealiasKeepAnnots match
+        case AnnotatedType(_, ann) if ann.symbol == defn.InferredAnnot => NoType
+        case AnnotatedType(parent, ann) if ann.symbol.isRetainsLike =>
+          if mayCaptureAny(ann) then NoType else AnnotatedType(defn.AnyType, ann)
+        case AnnotatedType(parent, _) => topBound(parent)
+        case OrType(t1, t2) =>
+          // a union bounds an argument only as far as both sides do
+          val b1 = topBound(t1)
+          val b2 = topBound(t2)
+          if !b1.exists || !b2.exists then NoType
+          else if b1 =:= b2 then b1
+          else NoType
+        case AndType(t1, t2) => topBound(t1).orElse(topBound(t2))
+        case t if t.derivesFromCapability || t.isArrayUnderStrictMut => NoType
+        case t: TypeParamRef => NoType
+        case t: TypeRef if !t.symbol.isClass => topBound(t.superType)
+        case _ => AnnotatedType(defn.AnyType, cc.RetainingAnnotation(defn.RetainsAnnot, defn.NothingType))
+
+      if !Feature.ccEnabled || argIsBottom then tp
+      else arg match
+        case closureDef(_) =>
+          formal.widenExpr.dealiasKeepAnnots match
+            case AnnotatedType(_, ann) if ann.symbol.isRetainsLike && mayCaptureAny(ann) =>
+              inferredFunction(tp, formal.widenExpr) match
+                case NoType => tp
+                case tp1 => proxyInferred = true; tp1
+            case AnnotatedType(parent, ann)
+            if ann.symbol.isRetainsLike && defn.isFunctionType(parent.dealias) =>
+              AnnotatedType(tp, ann)
+            case _ => tp
+        case _ if !formal.widenExpr.hasAnnotation(defn.InlineParamAnnot) =>
+          proxyInferred = true
+          topBound(formal.widenExpr) match
+            case NoType => tp
+            case bound => AndType(tp, declared(bound))
+        case _ => tp
+
     val bindingType =
       if argIsBottom then formal
       else if isByName then ExprType(argtpe.widen)
-      else argtpe.widen
+      else proxyType(argtpe.widen)
 
     var bindingFlags: FlagSet = InlineProxy
     if formal.widenExpr.hasAnnotation(defn.InlineParamAnnot) then
@@ -349,7 +461,7 @@ class Inliner(val call: tpd.Tree)(using Context):
       if bindingFlags.is(Inline) && argIsBottom then
         newArg = Typed(newArg, TypeTree(formal.widenExpr)) // type ascribe RHS to avoid type errors in expansion. See i8612.scala
       if isByName then DefDef(boundSym, newArg)
-      else ValDef(boundSym, newArg)
+      else ValDef(boundSym, newArg, inferred = proxyInferred)
     }.withSpan(boundSym.span)
     // Under capture checking, do not record the skolem: avoid-time recovery substitutes it
     // into the expansion's type, where cc's Fresh roots cannot absorb it — a summoned
@@ -765,9 +877,36 @@ class Inliner(val call: tpd.Tree)(using Context):
   def inlined(rhsToInline: tpd.Tree)(using Context): (List[MemberDef], Tree) =
     inlining.println(i"-----------------------\nInlining $call\nWith RHS $rhsToInline")
 
+    // Under capture checking, the type of `fn` with the call's inferred type arguments
+    // marked `@inferred`, as PostTyper marks them for an inline call (which a transparent
+    // call, inlined during typing, has not yet met): a proxy's type is bounded by its
+    // parameter's, and Setup must infer, not declare, what the call left to inference.
+    def markedType(fn: Tree): Type =
+      // An inferred capture-set argument (`refs^`) bounds nothing: inference chooses it to
+      // fit the argument. It cannot be marked inferred inside a capture set, so it bounds
+      // the parameter with `any`; the proxy's inferred half is still exact.
+      // (PostTyper has already marked those of a call it has seen; others are still
+      // InferredTypeTrees.)
+      def marked(targ: Tree) =
+        val (inferred, tp) = targ.tpe match
+          case AnnotatedType(tp, ann) if ann.symbol == defn.InferredAnnot => (true, tp)
+          case tp => (targ.isInstanceOf[InferredTypeTree], tp)
+        if !inferred then targ.tpe
+        else if tp.typeSymbol == defn.Caps_CapSet then
+          AnnotatedType(defn.Caps_CapSet.typeRef, cc.RetainingAnnotation(defn.RetainsCapAnnot))
+        else AnnotatedType(tp, Annotations.Annotation(defn.InferredAnnot, targ.span))
+      fn match
+        case TypeApply(fn1, targs) => markedType(fn1) match
+          case pt: PolyType => pt.instantiate(targs.map(marked))
+          case _ => fn.tpe.widen
+        case Apply(fn1, args) => markedType(fn1) match
+          case mt: MethodType => mt.instantiate(args.tpes)
+          case _ => fn.tpe.widen
+        case _ => fn.tpe.widen
+
     def paramTypess(call: Tree, acc: List[List[Type]]): List[List[Type]] = call match
       case Apply(fn, args) =>
-        fn.tpe.widen.match
+        (if Feature.ccEnabled then markedType(fn) else fn.tpe.widen).match
           case mt: MethodType => paramTypess(fn, mt.instantiateParamInfos(args.tpes) :: acc)
           case _ => Nil
       case TypeApply(fn, _) => paramTypess(fn, acc)
diff --git a/tests/neg-custom-args/captures/proxycap.scala b/tests/neg-custom-args/captures/proxycap.scala
new file mode 100644
index 0000000000000000000000000000000000000000..09dd33084ec4a11eec80f15cdfa468c521bb3c46
--- /dev/null
+++ b/tests/neg-custom-args/captures/proxycap.scala
@@ -0,0 +1,19 @@
+// A closure's proxy keeps the bound its parameter declares: the argument is checked
+// against the proxy alone, so capture sets are inferred only where the parameter's
+// function type may capture anything.
+
+inline def runPure(action: () -> Unit): Unit = action()
+inline def runOnly(io: Object^)(action: () ->{io} Unit): Unit = action()
+
+def test(io: Object^, other: Object^): Unit =
+  runPure(() => println(io))         // error
+  runOnly(io)(() => println(other))  // error
+  runOnly(io)(() => println(io))
+
+class Res extends caps.SharedCapability
+inline def useOnly(io: Res)(x: Object^{io}): Unit = println(x)
+inline def usePure(x: Object^{}): Unit = println(x)
+
+def args(io: Res, other: Res, o: Object^{other}): Unit =
+  useOnly(io)(identity(o))  // error
+  usePure(identity(o))      // error
diff --git a/tests/pos-custom-args/captures/proxycap.scala b/tests/pos-custom-args/captures/proxycap.scala
new file mode 100644
index 0000000000000000000000000000000000000000..bf53644a8fadbeff5dc8b61677326affc65da87c
--- /dev/null
+++ b/tests/pos-custom-args/captures/proxycap.scala
@@ -0,0 +1,54 @@
+// A closure passed for a non-inline function parameter of an inline method may
+// capture what the parameter allows. Where the parameter's function type may capture
+// anything (`=>`, `?=>`), the proxy's capture set is inferred, so it is exactly what
+// the closure captures: not a fresh `any`, which separation checking would reject as
+// hiding the captured references from their later uses.
+import language.experimental.separationChecking
+
+extension [value](iterable: Iterable[value])
+  inline def fuse[state](base: state)(lambda: (state, value) ?=> state): state =
+    val iterator: Iterator[value] = iterable.iterator
+    var state: state = base
+    while iterator.hasNext do state = lambda(using state, iterator.next())
+    state
+
+  inline def each(lambda: Int ?=> value => Unit): Unit =
+    iterable.foreach(lambda(using 0))
+
+inline def twice[result](action: () => result): result =
+  action()
+  action()
+
+inline def runOnly(io: Object^)(action: () ->{io} Unit): Unit = action()
+
+def fold[acc](initial: acc)(lambda: (Int, acc) => Exception => acc): acc =
+  val errors = List[Exception]()
+  (0 until errors.length).fuse(initial)(lambda(summon[Int], summon[acc])(errors(summon[Int])))
+
+def run(io: Object^): Unit =
+  twice(() => println(io))
+  List(1, 2).each(x => println(io))   // a capturing function in the closure's result
+  println(io)                         // io is not hidden by either proxy
+  runOnly(io)(() => println(io))      // an explicit capture set is kept
+
+// Any other argument's proxy is inferred, and bounded by its parameter's declared type.
+class Res extends caps.SharedCapability
+inline def useOnly(io: Res)(x: Object^{io}): Unit = println(x)
+inline def useAny(x: Object^): Unit = println(x)
+
+def legit(io: Res, o: Object^{io}): Unit =
+  useOnly(io)(identity(o))
+  useAny(identity(o))
+
+// An array in an argument's type is not declared as a fresh capability.
+class Buf:
+  def array(): Array[Byte] | Null = new Array[Byte](4)
+
+def size(bytes: Array[Byte]): Int = bytes.length
+def bufSize(b: Buf): Int = size(b.array().nn)
+
+// An inferred capture-set argument bounds nothing.
+extension [element, refs^](array: Array[element]^{refs})
+  inline def len: Int = array.length
+
+def lengths(a: Array[Int]^{}, n: Int): Int = identity(a).len + Array.fill(n)(0).len
