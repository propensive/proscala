diff --git a/compiler/src/dotty/tools/dotc/cc/CCState.scala b/compiler/src/dotty/tools/dotc/cc/CCState.scala
index 11c65af580dbeb2bf568a524e380754bcbfb81a0..3ffbe76cf3cda0bcb86c8fa2be0fad53175bee5a 100644
--- a/compiler/src/dotty/tools/dotc/cc/CCState.scala
+++ b/compiler/src/dotty/tools/dotc/cc/CCState.scala
@@ -109,6 +109,8 @@ class CCState:
 
   private var collapseLocalCaps: Boolean = false
 
+  private var atomicIncludes: Boolean = false
+
   private var discardUses: Boolean = false
 
   // ------- Caches for symbols --------------------------------------------------
@@ -179,6 +181,21 @@ object CCState:
   /** Should all LocalCap instances be treated as equal to GlobalAny? */
   def collapseLocalCaps(using Context): Boolean = ccState.collapseLocalCaps
 
+  /** Run `op` so that including an element in a capture set either succeeds or
+   *  leaves no trace. Otherwise the sets depending on a variable keep an element they
+   *  accepted before another of them rejected it, and a comparison that is tried a second
+   *  way finds it there. That goes unnoticed where a failed comparison is an error, but
+   *  not where it is an attempt, as in the unification done before override checking.
+   */
+  inline def withAtomicIncludes[T](op: => T)(using Context): T =
+    val ccs = ccState
+    val saved = ccs.atomicIncludes
+    ccs.atomicIncludes = true
+    try op finally ccs.atomicIncludes = saved
+
+  /** Should a failed inclusion be undone in the sets it had already reached? */
+  def atomicIncludes(using Context): Boolean = ccState.atomicIncludes
+
   /** Run `op` but suppress all recording of uses in `markFree` */
    inline def withDiscardedUses[T](op: => T)(using Context): T =
     if isCaptureCheckingOrSetup then
diff --git a/compiler/src/dotty/tools/dotc/cc/CaptureSet.scala b/compiler/src/dotty/tools/dotc/cc/CaptureSet.scala
index 1c3e94f0de9a787d8d9607f96525471d44053dcb..31ce615bb2420255c7d9e0195c4432a1693c0831 100644
--- a/compiler/src/dotty/tools/dotc/cc/CaptureSet.scala
+++ b/compiler/src/dotty/tools/dotc/cc/CaptureSet.scala
@@ -900,9 +900,10 @@ object CaptureSet:
         newElemAddedHandlers.foreach(_(elem))
         val normElem = if isMaybeSet then elem else elem.stripMaybe
         // assert(id != 5 || elems.size != 3, this)
-        val res = deps.forall: dep =>
+        def forward = deps.forall: dep =>
           reporting.trace(i"forward $normElem from $this # $id to $dep # ${dep.maybeId} of class ${dep.getClass.toString}"):
             dep.tryInclude(normElem, this)
+        val res = if CCState.atomicIncludes then TypeComparer.atomicOp(forward) else forward
         if ccConfig.checkSkippedMaps && res then checkSkippedMaps(elem)
         if !res then
           elems -= elem
diff --git a/compiler/src/dotty/tools/dotc/cc/CheckCaptures.scala b/compiler/src/dotty/tools/dotc/cc/CheckCaptures.scala
index 410679d83de9478508991f0470fbf6f88af0e712..a4224c3f77298d72874b88dd07a9b1a260ce3fbf 100644
--- a/compiler/src/dotty/tools/dotc/cc/CheckCaptures.scala
+++ b/compiler/src/dotty/tools/dotc/cc/CheckCaptures.scala
@@ -2268,10 +2268,81 @@ class CheckCaptures extends Recheck, SymTransformer:
             checkAnnot(defn.ReserveAnnot)
       end OverridingPairsCheckerCC
 
+      /** Unify the capture set variables in the parameter types of `clazz`'s methods with
+       *  those in the parameter types of the methods they override, and solve them.
+       *
+       *  Overrides are checked with `frozen_<:<`, under which an unsolved capture set
+       *  variable is related to nothing but itself, and parameter types must be the same.
+       *  The variables in a member's signature are normally solved by then, being those of
+       *  its inferred result type. But a type argument inferred for an inline call is
+       *  `@inferred` wherever it occurs in the expansion, so each occurrence in a class
+       *  there gets a variable of its own: in a method's parameter type, and in the type
+       *  member or the parent's type argument from which the method it overrides takes its
+       *  parameter type. Nothing else relates or solves these.
+       *
+       *  Every pair is unified before any variable is solved, so that the result does not
+       *  depend on the order of the pairs. The variables can be solved here because
+       *  overrides are checked after everything that could add to them. Solving them is
+       *  what lets the frozen check succeed: each time a member's info is taken,
+       *  `asSeenFrom` maps an unsolved variable to a new one derived from it.
+       */
+      private def unifyParamVars(clazz: ClassSymbol, tree: Tree)(using Context): Unit =
+        val self = clazz.thisType
+        val unified = new mutable.ListBuffer[Type]
+
+        // An attempt: parameter types that differ in more than unsolved variables stay as
+        // they are, for the override check to report.
+        def sameWhenUnified(tp1: Type, tp2: Type): Boolean =
+          !TypeComparer.isSameTypeWhenFrozen(tp1, tp2)
+          && withAtomicIncludes(TypeComparer.atomicOp(TypeComparer.isSameType(tp1, tp2)))
+
+        def unify(memberTp: Type, otherTp: Type): Unit = (memberTp, otherTp) match
+          case (memberTp: MethodType, otherTp: MethodType)
+          if memberTp.paramInfos.hasSameLengthAs(otherTp.paramInfos) =>
+            for (formal1, formal2) <- memberTp.paramInfos.lazyZip(otherTp.paramInfos) do
+              val formal2a = if otherTp.isParamDependent then formal2.subst(otherTp, memberTp) else formal2
+              if sameWhenUnified(formal1, formal2a) then unified += formal1 += formal2a
+            unifyResults(memberTp, otherTp)
+          case (memberTp: PolyType, otherTp: PolyType)
+          if memberTp.paramNames.hasSameLengthAs(otherTp.paramNames) =>
+            unifyResults(memberTp, otherTp)
+          case _ =>
+
+        def unifyResults(memberTp: LambdaType, otherTp: LambdaType): Unit =
+          val otherRes = otherTp.resType
+          unify(memberTp.resType, if otherTp.isResultDependent then otherRes.subst(otherTp, memberTp) else otherRes)
+
+        def solveVar(refs: CaptureSet): Unit = refs match
+          case refs: CaptureSet.DerivedVar => solveVar(refs.source)
+          case refs: CaptureSet.Var if !refs.isConst => refs.markSolved(provisional = false)
+          case _ =>
+
+        val solveVars = new TypeTraverser:
+          def traverse(t: Type) =
+            val t1 = t.dealiasKeepAnnots
+            if t1 ne t then traverse(t1)
+            else t match
+              case CapturingType(parent, refs) =>
+                solveVar(refs)
+                traverse(parent)
+              case _ =>
+                traverseChildren(t)
+
+        val pairs = OverridingPairsCheckerCC(clazz, self, tree)
+        while pairs.hasNext do
+          val member = pairs.overriding
+          val other = pairs.overridden
+          if member.is(Method) && pairs.needsCheck(member, other) then
+            unify(self.memberInfo(member), self.memberInfo(other))
+          pairs.next()
+        unified.foreach(solveVars.traverse)
+      end unifyParamVars
+
       def traverse(t: Tree)(using Context) =
         t match
           case t: Template =>
             withCollapsedLocalCaps:
+              unifyParamVars(ctx.owner.asClass, t)
               checkAllOverrides(ctx.owner.asClass, OverridingPairsCheckerCC(_, _, t))
           case _ =>
         traverseChildren(t)
diff --git a/tests/neg-custom-args/captures/inferred-targ-override.scala b/tests/neg-custom-args/captures/inferred-targ-override.scala
new file mode 100644
index 0000000000000000000000000000000000000000..4cf9206b298673acf766ecd3ef086adb1cbf58b3
--- /dev/null
+++ b/tests/neg-custom-args/captures/inferred-targ-override.scala
@@ -0,0 +1,19 @@
+// The capture set variables unified for an override are still checked: a method that needs
+// its parameter to be pure cannot implement one that is passed a capability.
+
+class Point
+
+trait Member:
+  type Self
+  def text(value: Self): String
+
+def pure(point: Point): String = "x"
+
+inline def member[value <: Point](x: value): Member { type Self = value } =
+  new Member:
+    type Self = value
+    def text(arg: value): String = pure(arg)
+
+def ok(point: Point) = member(point).text(point)
+
+def test(point: Point, io: Point^) = member(point).text(io) // error
diff --git a/tests/pos-custom-args/captures/inferred-targ-override.scala b/tests/pos-custom-args/captures/inferred-targ-override.scala
new file mode 100644
index 0000000000000000000000000000000000000000..25e55f304f310ba651a7068a604e7c3bc1df07b4
--- /dev/null
+++ b/tests/pos-custom-args/captures/inferred-targ-override.scala
@@ -0,0 +1,39 @@
+// A type argument inferred for an inline call gets a capture set variable of its own
+// wherever it occurs in the expansion. In a class there, the ones in a method's parameter
+// type and in the type the overridden method takes its parameter type from must be unified
+// for the override to be accepted.
+
+class Point
+
+trait Member:
+  type Self
+  def text(value: Self): String
+
+trait Param[A]:
+  def text(value: A): String
+
+inline def member[value](x: value): Member { type Self = value } =
+  new Member:
+    type Self = value
+    def text(arg: value): String = "x"
+
+inline def param[value](x: value): Param[value] =
+  new Param[value]:
+    def text(arg: value): String = "x"
+
+inline def nested[value](x: value): Param[List[value]] =
+  new Param[List[value]]:
+    def text(arg: List[value]): String = "x"
+
+// A SAM type for which the platform makes a class is expanded to one before capture checking
+inline def memberSam[value](x: value): Member { type Self = value } = arg => "x"
+inline def paramSam[value](x: value): Param[value] = arg => "x"
+
+def test(point: Point, io: Point^) =
+  member(point)
+  param(point)
+  nested(point)
+  memberSam(point)
+  paramSam(point)
+  member(point).text(io)
+  memberSam(point).text(io)
