diff --git a/compiler/src/dotty/tools/dotc/CompilationUnit.scala b/compiler/src/dotty/tools/dotc/CompilationUnit.scala
index ad1a896e5d633e779ae6845a5d9580f31deefccb..c2f2becb53cafd4e4263f342563b214e19fe6f3b 100644
--- a/compiler/src/dotty/tools/dotc/CompilationUnit.scala
+++ b/compiler/src/dotty/tools/dotc/CompilationUnit.scala
@@ -39,6 +39,15 @@ class CompilationUnit protected (val source: SourceFile, val info: CompilationUn
     val local = info
     if local == null then None else local.tastyInfo
 
+  /** The source file the trees of this unit were written in. For a unit read from
+   *  TASTy that is not `source`, which is the TASTy file, but the source the trees
+   *  were given when they were unpickled, whose lines the TASTy file records.
+   */
+  def treeSource: SourceFile =
+    if source.file != null && source.file.ext.isTasty && tpdTree.source.exists
+    then tpdTree.source
+    else source
+
 
   /** The source version for this unit, as determined by a language import */
   var sourceVersion: Option[SourceVersion] = None
