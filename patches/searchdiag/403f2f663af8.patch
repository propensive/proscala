diff --git a/tests/pos-macros/diagnostic-given/Test_2.scala b/tests/pos-macros/diagnostic-given/Test_2.scala
new file mode 100644
index 0000000000000000000000000000000000000000..8002e7ed2cb813cd3fc746daa638cb1e28883503
--- /dev/null
+++ b/tests/pos-macros/diagnostic-given/Test_2.scala
@@ -0,0 +1,18 @@
+import scala.util.NotGiven
+import scala.compiletime.summonFrom
+import Givens.given
+
+trait Missing
+class Cfg
+
+def withDefault(using c: Cfg = new Cfg) = c
+
+inline def choose: Int =
+  summonFrom:
+    case _: Missing => 1
+    case _ => 2
+
+def test =
+  summon[NotGiven[Missing]]
+  withDefault
+  assert(choose == 2)
