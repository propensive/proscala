+    def |(other: DescriptorFlags): DescriptorFlags = new DescriptorFlags(value | other.value)
+    def &(other: DescriptorFlags): DescriptorFlags = new DescriptorFlags(value & other.value)
+    def ^(other: DescriptorFlags): DescriptorFlags = new DescriptorFlags(value ^ other.value)
+    def unary_~ : DescriptorFlags = new DescriptorFlags(~value)
