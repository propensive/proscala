+        scala.scalajs.wit.unsigned.ULong, StreamError] = scala.scalajs.wit.native
+
+    @scala.scalajs.wit.annotation.WitResourceDrop
+    def close(): Unit = scala.scalajs.wit.native
+  }
+
+  object OutputStream {}
+
+}
