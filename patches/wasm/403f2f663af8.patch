+      superClass = None,
+      interfaces = Nil,
+      jsSuperClass = None,
+      jsNativeLoadSpec = None,
+      fields = Nil,
+      methods = Nil,
+      jsConstructor = None,
+      jsMethodProps = Nil,
+      jsNativeMembers = Nil,
