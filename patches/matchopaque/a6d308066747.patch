diff --git a/compiler/src/dotty/tools/dotc/inlines/Inliner.scala b/compiler/src/dotty/tools/dotc/inlines/Inliner.scala
index a23ad9127b45e0b2977df167c9028e8531e26f31..0f683b3ca22ba7df1e537466164143709bec96fb 100644
--- a/compiler/src/dotty/tools/dotc/inlines/Inliner.scala
+++ b/compiler/src/dotty/tools/dotc/inlines/Inliner.scala
@@ -714,11 +714,58 @@ class Inliner(val call: tpd.Tree)(using Context):
         .showing(i"transformed this binding exposing opaque aliases: $result", inlining)
   end accountForOpaques
 
+  /** `tp` with the aliases in it followed, at any depth: an applied match alias reduced
+   *  where it can be, and any other alias replaced by what it stands for. `widenDealias`
+   *  does this only at the top of a type, so an opaque type named through an alias
+   *  elsewhere would not be found in it:
+   *   - a `Cell[String]` that reduces to `Cell.Ref[String]` does not mention `Cell.Ref`.
+   *     Typer leaves no such type in a tree, since it simplifies the type of every tree
+   *     it types, but the type of a definition read from TASTy is as it was written;
+   *   - an `O { type Form = Int }` or a `List[O]`, where `O` is an alias of `Ops.O`
+   *     (such as an `export Ops.O` makes), does not mention `Ops`.
+   *
+   *  An opaque type is where the following stops, also where it is an alias: inside
+   *  the scope that declares it, and seen through the opaque proxy of an enclosing
+   *  inline call (`$proxy1.Scribe[Char]`, in an argument that call passes on to another
+   *  inline method). It names its owner already, and replacing it by its representation
+   *  would cast the argument to a type of the representation, which an opaque value
+   *  made in the inlined body does not conform to.
+   */
+  private def followAliases(tp: Type)(using Context): Type =
+    val follow = new TypeMap:
+      def apply(t: Type) = t match
+        case t: TypeRef if t.symbol.isOpaqueAlias => t
+        case AppliedType(tycon: TypeRef, _) if tycon.symbol.isOpaqueAlias => mapOver(t)
+        case t: AppliedType if t.isMatchAlias =>
+          val reduced = t.tryNormalize
+          if reduced.exists then apply(reduced) else mapOver(t)
+        case t: (TypeRef | AppliedType) =>
+          val dealiased = t.dealiasKeepAnnots
+          if dealiased ne t then apply(dealiased) else mapOver(t)
+        case _ => mapOver(t)
+    follow(tp)
+
   /** If value argument contains references to objects that contain opaque types,
    *  map them to their opaque proxies.
+   *
+   *  The aliases in the argument's type are followed (see `followAliases`) only if the
+   *  type as it stands mentions no such object. Where it does, the argument is cast
+   *  exactly as it always was, and an alias elsewhere in its type keeps its name:
+   *  with `type Bytes = Frozen[Byte]`, a `Frozen[Bytes]` is seen as `$proxy1.Frozen[Bytes]`,
+   *  whose elements are still the `Bytes` the caller expects back.
    */
   private def mapOpaquesInValueArg(arg: Tree)(using Context): Tree =
     val argType = arg.tpe.widenDealias
+    val cast = castToOpaqueProxies(arg, argType)
+    if cast ne arg then cast
+    else
+      val followed = followAliases(argType)
+      if followed ne argType then castToOpaqueProxies(arg, followed) else arg
+
+  /** `arg`, cast to `argType` as seen through the opaque proxies of the objects it
+   *  mentions, or as it is if it mentions none.
+   */
+  private def castToOpaqueProxies(arg: Tree, argType: Type)(using Context): Tree =
     addOpaqueProxies(argType, arg.span, forThisProxy = false)
     if opaqueProxies.nonEmpty then
       val mappedType = mapOpaques.typeMap(argType)
diff --git a/tests/pos-custom-args/captures/opaque-inline-alias-element/Lib_1.scala b/tests/pos-custom-args/captures/opaque-inline-alias-element/Lib_1.scala
new file mode 100644
index 0000000000000000000000000000000000000000..3d80d95804d7451e89948b39f417caeef2f3718f
--- /dev/null
+++ b/tests/pos-custom-args/captures/opaque-inline-alias-element/Lib_1.scala
@@ -0,0 +1,19 @@
+// An inline read from an opaque array whose element type is an alias of the same
+// opaque type. The receiver names the opaque type's owner as it is written, so it is
+// cast as upstream casts it, and the alias in the element position is left alone:
+// following it too would give the read the representation's type, `Array[Byte]`, which
+// separation checking does not accept as the `Frozen[Byte]` the caller expects.
+
+package lib
+
+import language.experimental.captureChecking
+import language.experimental.separationChecking
+
+opaque type Frozen[element] = Array[element]
+
+object Frozen:
+  def apply[element](array: Array[element]): Frozen[element]^{} =
+    array.asInstanceOf[Frozen[element]^{}]
+
+  extension [element, C^](buffer: Frozen[element]^{C})
+    inline def read(index: Int): element = buffer(index)
