diff --git a/compiler/src/dotty/tools/dotc/inlines/Inliner.scala b/compiler/src/dotty/tools/dotc/inlines/Inliner.scala
index 7bb5aaab4d283199dde0ad4643bcd9b06ff01278..d921c1d81ec353eb44ae336a1f621b4715560507 100644
--- a/compiler/src/dotty/tools/dotc/inlines/Inliner.scala
+++ b/compiler/src/dotty/tools/dotc/inlines/Inliner.scala
@@ -714,11 +714,33 @@ class Inliner(val call: tpd.Tree)(using Context):
         .showing(i"transformed this binding exposing opaque aliases: $result", inlining)
   end accountForOpaques
 
+  /** `tp` with the aliases in it followed, at any depth: an applied match alias reduced
+   *  where it can be, and any other alias replaced by what it stands for. `widenDealias`
+   *  does this only at the top of a type, so an opaque type named through an alias
+   *  elsewhere would not be found in it:
+   *   - a `Cell[String]` that reduces to `Cell.Ref[String]` does not mention `Cell.Ref`.
+   *     Typer leaves no such type in a tree, since it simplifies the type of every tree
+   *     it types, but the type of a definition read from TASTy is as it was written;
+   *   - an `O { type Form = Int }` or a `List[O]`, where `O` is an alias of `Ops.O`
+   *     (such as an `export Ops.O` makes), does not mention `Ops`.
+   */
+  private def followAliases(tp: Type)(using Context): Type =
+    val follow = new TypeMap:
+      def apply(t: Type) = t match
+        case t: AppliedType if t.isMatchAlias =>
+          val reduced = t.tryNormalize
+          if reduced.exists then apply(reduced) else mapOver(t)
+        case t: (TypeRef | AppliedType) =>
+          val dealiased = t.dealiasKeepAnnots
+          if dealiased ne t then apply(dealiased) else mapOver(t)
+        case _ => mapOver(t)
+    follow(tp)
+
   /** If value argument contains references to objects that contain opaque types,
    *  map them to their opaque proxies.
    */
   private def mapOpaquesInValueArg(arg: Tree)(using Context): Tree =
-    val argType = arg.tpe.widenDealias
+    val argType = followAliases(arg.tpe.widenDealias)
     addOpaqueProxies(argType, arg.span, forThisProxy = false)
     if opaqueProxies.nonEmpty then
       val mappedType = mapOpaques.typeMap(argType)
diff --git a/tests/pos-custom-args/captures/opaque-inline-export-alias.scala b/tests/pos-custom-args/captures/opaque-inline-export-alias.scala
new file mode 100644
