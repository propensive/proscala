--- /dev/null
+++ b/tests/pos/opaque-inline-export-alias.scala
@@ -0,0 +1,22 @@
+// An inline extension of an opaque type, called on a value whose type names the
+// opaque type through an alias that `widenDealias` does not follow: below a
+// refinement, or as a type argument.
+
+package minipkg
+
+object mini:
+  opaque type O = Int
+  extension (o: O)
+    inline def next: Int = o + 1
+  extension (os: List[O])
+    inline def total: Int = os.sum
+  object O:
+    def mint(i: Int): O = i
+
+export mini.O
+
+object Use:
+  def refined(o: O { type Form = Int }): Int = o.next
+  def argument(os: List[O]): Int = os.total
+  def plain(o: O): Int = o.next
+  def direct(o: mini.O { type Form = Int }): Int = o.next
diff --git a/tests/pos/opaque-inline-match-alias/Lib_1.scala b/tests/pos/opaque-inline-match-alias/Lib_1.scala
new file mode 100644
index 0000000000000000000000000000000000000000..ea7db0d563996cc045fa6acc79d84faba446bcac
--- /dev/null
+++ b/tests/pos/opaque-inline-match-alias/Lib_1.scala
@@ -0,0 +1,29 @@
+package lib
+
+import java.util.concurrent.atomic as juca
+
+object Cell:
+  opaque type Whole = juca.AtomicInteger
+  opaque type Ref[value] = juca.AtomicReference[value]
+
+  def apply(initial: Int): Whole = juca.AtomicInteger(initial)
+  def apply[value](initial: value): Ref[value] = juca.AtomicReference(initial)
+
+  object Whole:
+    extension (whole: Whole) inline def apply(): Int = whole.get()
+
+  object Ref:
+    extension [value](ref: Ref[value])
+      inline def apply(): value = ref.get().nn
+      inline def swap(value: value): value = ref.getAndSet(value).nn
+
+type Cell[value] = value match
+  case Int => Cell.Whole
+  case _   => Cell.Ref[value]
+
+// The declared types of these are read from TASTy by `Test_2.scala`, where they
+// are unreduced applications of the match alias `Cell`.
+object Holder:
+  val ref: Cell[String] = Cell("a")
+  val whole: Cell[Int] = Cell(1)
+  val refs: List[Cell[String]] = List(Cell("a"))
