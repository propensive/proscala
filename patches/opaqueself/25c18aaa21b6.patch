 compiler/src/dotty/tools/dotc/cc/Setup.scala  | 31 +++++++++++++++++++
 .../opaque-frozen-argument/Lib_1.scala        | 22 +++++++++++++
 .../opaque-frozen-argument/Test_2.scala       | 12 +++++++
 3 files changed, 65 insertions(+)
 create mode 100644 tests/pos-custom-args/captures/opaque-frozen-argument/Lib_1.scala
 create mode 100644 tests/pos-custom-args/captures/opaque-frozen-argument/Test_2.scala

diff --git a/compiler/src/dotty/tools/dotc/cc/Setup.scala b/compiler/src/dotty/tools/dotc/cc/Setup.scala
index e75197bd799411973ac915fc02553fde413d685f..c7bccd6574aa53c270d6f745904635892be6fd2b 100644
--- a/compiler/src/dotty/tools/dotc/cc/Setup.scala
+++ b/compiler/src/dotty/tools/dotc/cc/Setup.scala
@@ -546,6 +546,37 @@ class Setup extends PreRecheck, SymTransformer, SetupAPI:
         case t1 =>
           super.mapFollowingAliases(t1)
 
+      /** An opaque alias is known inside its scope by a refinement of the self type
+       *  of the class that owns it, `{ type A[X] = Rhs }`. Keep that alias free of the
+       *  capture set which a capability `Rhs` implies, as a type alias's own info is
+       *  (`type X = C`, not `type X = C^{any}`): the set is implied anew by each `A[T]`
+       *  written in scope. Left in the alias it is a root that every `A[T]^cs` acquires
+       *  when dealiased, so that a frozen `A[T]^{}` in a type argument is boxed as
+       *  `Rhs^{any.rd}` -- but only where the alias is read from this info and not from
+       *  the one before capture checking, which depends on what else the run looked at
+       *  first: a signature could be read differently in a separate compilation.
+       */
+      override def mapClassInfo(tp: ClassInfo): ClassInfo =
+        def stripAlias(alias: Type): Type = alias match
+          case alias: HKTypeLambda =>
+            alias.derivedLambdaType(resType = stripAlias(alias.resType))
+          case _ =>
+            stripImpliedCaptureSet(alias)
+        def stripOpaqueAliases(self: Type): Type = self match
+          case self @ CapturingType(parent, refs) =>
+            self.derivedCapturingType(stripOpaqueAliases(parent), refs)
+          case self @ RefinedType(parent, rname, rinfo: TypeAlias) =>
+            self.derivedRefinedType(
+              stripOpaqueAliases(parent), rname, rinfo.derivedAlias(stripAlias(rinfo.alias)))
+          case _ =>
+            self
+        val tp1 = super.mapClassInfo(tp)
+        tp1.selfInfo match
+          case self: Type if self ne tp.selfInfo =>
+            tp1.derivedClassInfo(selfInfo = stripOpaqueAliases(self))
+          case _ =>
+            tp1
+
       /** Map references to capability classes C to C^{any}, or (if Mutable)
        *  tp C^{any.rd}. Normalize captures and map to dependent functions.
        */
diff --git a/tests/pos-custom-args/captures/opaque-frozen-argument/Lib_1.scala b/tests/pos-custom-args/captures/opaque-frozen-argument/Lib_1.scala
new file mode 100644
index 0000000000000000000000000000000000000000..56190e91baece6e5edb8a03b462756da69bd9298
--- /dev/null
+++ b/tests/pos-custom-args/captures/opaque-frozen-argument/Lib_1.scala
@@ -0,0 +1,22 @@
+// A frozen opaque array in a type argument of a result type, in a signature read from
+// TASTy. Using `size` first makes the capture checker look at `Array` inside its scope
+// after Setup has transformed the class which holds it; `boxed`'s result must still be
+// read as `Box[Array[E]^{}]`, not as `Box[scala.Array[E]^{any.rd}]`.
+
+package lib
+
+import language.experimental.captureChecking
+import language.experimental.separationChecking
+
+class Box[+T](val value: T)
+
+object Array:
+  def size[E](xs: Array[E]^{}): Int = xs.length
+  def boxed[E](xs: Array[E]^{}): Box[Array[E]^{}] = Box(xs)
+
+object Bytes:
+  def size(xs: Bytes^{}): Int = xs.length
+  def boxed(xs: Bytes^{}): Box[Bytes^{}] = Box(xs)
+
+opaque type Array[E] = scala.Array[E]
+opaque type Bytes = scala.Array[Byte]
diff --git a/tests/pos-custom-args/captures/opaque-frozen-argument/Test_2.scala b/tests/pos-custom-args/captures/opaque-frozen-argument/Test_2.scala
new file mode 100644
index 0000000000000000000000000000000000000000..959e7eba3987f397853921f8b189af9a358386ce
--- /dev/null
+++ b/tests/pos-custom-args/captures/opaque-frozen-argument/Test_2.scala
@@ -0,0 +1,12 @@
+import language.experimental.captureChecking
+import language.experimental.separationChecking
+
+import lib.*
+
+def test(xs: Array[Int]^{}): Box[Array[Int]^{}] =
+  val size = Array.size(xs)
+  Array.boxed(xs)
+
+def bytes(xs: Bytes^{}): Box[Bytes^{}] =
+  val size = Bytes.size(xs)
+  Bytes.boxed(xs)
