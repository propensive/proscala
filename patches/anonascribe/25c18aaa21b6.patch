From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jon Pretty <jon.pretty@propensive.com>
Date: Tue, 13 Oct 2026 12:20:03 +0200
Subject: Treat an anonymous class instance's ascription as inferred

Typer ascribes an anonymous class instance with the type it avoids the class
by, as an InferredTypeTree. Read back from TASTy, in an inline body, it is a
plain TypeTree, and Setup mapped it as a declared type: a bare stateful type
became read-only (`Stream^{any.rd}`), so an instance returned as an exclusive
`Stream^` failed at every inline site in another unit (coaxial's
`wasiSockets`). No source can write `new $anon()`, so Setup now treats such
an ascription as inferred.

Developed with LLM assistance (Claude Code).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Proscala-Patch: anonascribe
---
 compiler/src/dotty/tools/dotc/cc/Setup.scala  | 17 +++++++++++++++--
 .../captures/anonascribe/Lib_1.scala          | 19 +++++++++++++++++++
 .../captures/anonascribe/Test_2.scala         |  3 +++
 3 files changed, 37 insertions(+), 2 deletions(-)
 create mode 100644 tests/pos-custom-args/captures/anonascribe/Lib_1.scala
 create mode 100644 tests/pos-custom-args/captures/anonascribe/Test_2.scala

diff --git a/compiler/src/dotty/tools/dotc/cc/Setup.scala b/compiler/src/dotty/tools/dotc/cc/Setup.scala
index 32c62516f5f989d899cb50cfd4748ab5bea4f89b..b990c4d3c71a2c027d3ff88a39ef2b16d0fa4823 100644
--- a/compiler/src/dotty/tools/dotc/cc/Setup.scala
+++ b/compiler/src/dotty/tools/dotc/cc/Setup.scala
@@ -680,10 +680,10 @@ class Setup extends PreRecheck, SymTransformer, SetupAPI:
     /** Transform type of tree, and remember the transformed type as the type of the tree
      *  @pre !(boxed && sym.exists)
      */
-    private def transformTT(tree: TypeTree, sym: Symbol, boxed: Boolean, typeArgFormal: Type = NoType)(using Context): Unit =
+    private def transformTT(tree: TypeTree, sym: Symbol, boxed: Boolean, typeArgFormal: Type = NoType, inferred: Boolean = false)(using Context): Unit =
       if !tree.hasNuType then
         var transformed =
-          if tree.isInferred || sym.is(ModuleVal)
+          if inferred || tree.isInferred || sym.is(ModuleVal)
           then transformInferredType(tree.tpe, sym, typeArgFormal)
           else transformExplicitType(tree.tpe, sym, tptToCheck = tree)
         if boxed then transformed = transformed.boxDeeply
@@ -788,6 +788,13 @@ class Setup extends PreRecheck, SymTransformer, SetupAPI:
           catches.foreach(traverse)
           traverse(finalizer)
 
+        case tree @ Typed(expr, tpt: TypeTree) if isAnonymousInstance(expr) =>
+          // Typer ascribes an anonymous class instance with the type it avoids the class by.
+          // That type is inferred, but read back from TASTy, in an inline body, it is a
+          // plain TypeTree.
+          traverse(expr)
+          transformTT(tpt, NoSymbol, boxed = false, inferred = true)
+
         case tree: New =>
 
         case _ =>
@@ -799,6 +806,12 @@ class Setup extends PreRecheck, SymTransformer, SetupAPI:
       if tree.isInstanceOf[ValDef] then tree.removeAttachment(inlines.Inliner.ProxyCaptures)
     end traverse
 
+    /** Is `tree` the instantiation `new $anon()` of an anonymous class? */
+    private def isAnonymousInstance(tree: Tree)(using Context): Boolean =
+      tree.tpe.typeSymbol.isAnonymousClass && (methPart(tree) match
+        case Select(New(_), nme.CONSTRUCTOR) => true
+        case _ => false)
+
     /** Processing done on node `tree` after its children are traversed */
     def postProcess(tree: Tree)(using Context): Unit = tree match
       case tree: TypeTree =>
diff --git a/tests/pos-custom-args/captures/anonascribe/Lib_1.scala b/tests/pos-custom-args/captures/anonascribe/Lib_1.scala
new file mode 100644
index 0000000000000000000000000000000000000000..e735efc35ff53859823c9392b3fec4d89720a573
--- /dev/null
+++ b/tests/pos-custom-args/captures/anonascribe/Lib_1.scala
@@ -0,0 +1,19 @@
+trait Stream extends caps.ExclusiveCapability, caps.Stateful:
+  def start: Int
+  update def skip(count: Int): Unit
+
+trait Backend:
+  def source(): Stream^
+
+object Backends:
+  // Typer ascribes the anonymous class instance below with `Stream`, the type it avoids
+  // the class by; read back from TASTy, at the inline site, that ascription is a plain
+  // type tree
+  inline given backend: Backend = new Backend:
+    private def readStream(start: Int): Stream^ =
+      new Stream:
+        private var start0: Int = start
+        def start: Int = start0
+        update def skip(count: Int): Unit = start0 += count
+
+    def source(): Stream^ = readStream(1)
diff --git a/tests/pos-custom-args/captures/anonascribe/Test_2.scala b/tests/pos-custom-args/captures/anonascribe/Test_2.scala
new file mode 100644
