 .../src/dotty/tools/dotc/cc/CaptureSet.scala  | 15 ++++++++++-
 compiler/src/dotty/tools/dotc/cc/Setup.scala  | 11 ++++++++
 .../captures/aliascap-lend.scala              | 24 ++++++++++++++++++
 .../captures/aliascap-lend.scala              | 25 +++++++++++++++++++
 4 files changed, 74 insertions(+), 1 deletion(-)
 create mode 100644 tests/neg-custom-args/captures/aliascap-lend.scala
 create mode 100644 tests/pos-custom-args/captures/aliascap-lend.scala

diff --git a/compiler/src/dotty/tools/dotc/cc/CaptureSet.scala b/compiler/src/dotty/tools/dotc/cc/CaptureSet.scala
index f7c9ec1f7c90a4e46560901f9e610a87da49e8b5..4223954ccbb99208155937fbf7465fe2c5986c34 100644
--- a/compiler/src/dotty/tools/dotc/cc/CaptureSet.scala
+++ b/compiler/src/dotty/tools/dotc/cc/CaptureSet.scala
@@ -1165,11 +1165,24 @@ object CaptureSet:
         // forward propagation from source that hits the first branch `if origin eq source then`.
         try
           reporting.trace(i"prop backwards $elem from $this # $id to $source # ${source.id} via $summarize"):
-            source.tryInclude(bimap.inverse.mapCapability(elem), this)
+            val sourceElem = bimap.inverse.mapCapability(elem)
+            if config.Proscala.enabled(config.Proscala.AliasCaptures) && lostTracking(elem, sourceElem)
+            then failWith(IncludeFailure(this, elem))
+            else source.tryInclude(sourceElem, this)
         catch case ex: AssertionError =>
           println(i"fail while prop backwards tryInclude $elem of ${elem.getClass} from $this # $id / ${this.summarize} to $source # ${source.id}")
           throw ex
 
+    /** Would propagating `elem` back to the source as `sourceElem` lose it? A parameter
+     *  is tracked by what its type captures, and substitution can change that: in
+     *  `(handle: lender.Result) ?=> R` the parameter captures nothing, but with
+     *  `handleLender` for `lender`, where `type Result = Handle^`, it captures a
+     *  `Handle`. Mapped back to the unsubstituted binder, the parameter would count as
+     *  pure, be accounted for by any set, and so escape without a level check.
+     */
+    private def lostTracking(elem: Capability, sourceElem: Capability)(using Context): Boolean =
+      elem.core.isInstanceOf[ParamRef] && (sourceElem ne elem) && elem.isTracked && !sourceElem.isTracked
+
     /** For a BiTypeMap, supertypes of the mapped type also constrain
      *  the source via the inverse type mapping and vice versa. That is, if
      *   B = f(A) and B <: C, then A <: f^-1(C), so C should flow into
diff --git a/compiler/src/dotty/tools/dotc/cc/Setup.scala b/compiler/src/dotty/tools/dotc/cc/Setup.scala
index 052d5d73c5ad60fb8342823e398de2b5560b6651..162f8d80f628dda9ae7b2f8de6f2cd668108731a 100644
--- a/compiler/src/dotty/tools/dotc/cc/Setup.scala
+++ b/compiler/src/dotty/tools/dotc/cc/Setup.scala
@@ -577,6 +577,17 @@ class Setup extends PreRecheck, SymTransformer, SetupAPI:
             |following a function arrow such as `=>` or `->`.""")
 
     if initialVariance < 0 then tp2
+    else if sym.isAliasType && config.Proscala.enabled(config.Proscala.AliasCaptures) then
+      // Keep `caps.any` global in a type alias's own info. Capture-checked units expand
+      // aliases during Setup of each USING symbol, localizing root capabilities per use
+      // site, so the alias's own info is not consulted there. It is consulted when the
+      // signature of a symbol from a unit that was NOT capture-checked mentions the alias:
+      // such signatures are fluidified without following aliases, so rechecking dealiases
+      // late and would expose a LocalCap owned by the alias itself — a capability at the
+      // alias's own (package-)level that no use-site capability can flow into. Leaving the
+      // root global here lets recheck freshen it per application, matching the behaviour
+      // of capture-checked callees (mixed-compilation interop).
+      tp2
     else globalCapToLocal(tp2, Origin.InDecl(sym))
   end transformExplicitType
 
diff --git a/tests/neg-custom-args/captures/aliascap-lend.scala b/tests/neg-custom-args/captures/aliascap-lend.scala
new file mode 100644
index 0000000000000000000000000000000000000000..3dcc9ebb80b4c04b50d49296a68292254d02644d
--- /dev/null
+++ b/tests/neg-custom-args/captures/aliascap-lend.scala
@@ -0,0 +1,24 @@
+//> using options -Zalias-captures
+
+class Handle extends caps.ExclusiveCapability:
+  def alive: Boolean = true
+
+trait Lender:
+  type Result
+  def lend[result](lambda: (handle: Result) ?=> result): result
+
+class HandleLender extends Lender:
+  type Result = Handle^
+  def lend[result](lambda: (handle: Result) ?=> result): result = lambda(using Handle())
+
+given handleLender: HandleLender = HandleLender()
+
+// `lender.Result` is abstract where `lendDef` is defined and an alias of `Handle^` at
+// the call: the lambda's parameter is tracked there, and may not escape in the result
+extension (x: Int)
+  def lendDef[result](using lender: Lender^)(lambda: (handle: lender.Result) ?=> result): result =
+    lender.lend(lambda)
+
+def closure(): () => Boolean = 1.lendDef(h ?=> () => h.alive) // error
+def pureClosure(): () -> Boolean = 1.lendDef(h ?=> () => h.alive) // error
+def handle(): Handle^ = 1.lendDef(h ?=> h) // error
diff --git a/tests/pos-custom-args/captures/aliascap-lend.scala b/tests/pos-custom-args/captures/aliascap-lend.scala
new file mode 100644
index 0000000000000000000000000000000000000000..49f397df986d68f7b251bdab25de8d95ddfaf8c0
--- /dev/null
+++ b/tests/pos-custom-args/captures/aliascap-lend.scala
@@ -0,0 +1,25 @@
+//> using options -Zalias-captures
+
+class Handle extends caps.ExclusiveCapability:
+  def alive: Boolean = true
+
+trait Lender:
+  type Result
+  def lend[result](lambda: (handle: Result) ?=> result): result
+
+class HandleLender extends Lender:
+  type Result = Handle^
+  def lend[result](lambda: (handle: Result) ?=> result): result = lambda(using Handle())
+
+given handleLender: HandleLender = HandleLender()
+
+// A lambda using what it is lent, without letting it escape
+extension (x: Int)
+  def lendDef[result](using lender: Lender^)(lambda: (handle: lender.Result) ?=> result): result =
+    lender.lend(lambda)
+
+  def lendDefHat[result](using lender: Lender^)(lambda: (handle: lender.Result^) ?=> result): result =
+    lender.lend(lambda)
+
+def use(): Boolean = 1.lendDef(h ?=> h.alive == true)
+def useHat(): Boolean = 1.lendDefHat(h ?=> h.alive == true)
