diff --git a/tests/pos-macros/from-tasty-macro-in-inputs/Use_2.scala b/tests/pos-macros/from-tasty-macro-in-inputs/Use_2.scala
new file mode 100644
index 0000000000000000000000000000000000000000..43b1bfdbcb2c80c815d967ea37e438a15171cbf9
