From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jon Pretty <jon.pretty@propensive.com>
Date: Fri, 17 Jul 2026 15:22:49 +0200
Subject: Cache inert types in capture-checking Setup
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A type that Setup maps to the identical instance contains nothing to
transform under any traversal state, so it never needs re-walking.
Without this, deeply-nested alias unions — such as HTML content
category types, hundreds of shared singleton labels behind several
alias layers — are re-expanded once per path through
mapFollowingAliases, which is exponential in the alias nesting depth:
a single method signature over such a type did not finish compiling.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Proscala-Patch: inertcache
---
 compiler/src/dotty/tools/dotc/cc/Setup.scala | 32 ++++++++++++++------
 1 file changed, 22 insertions(+), 10 deletions(-)

diff --git a/compiler/src/dotty/tools/dotc/cc/Setup.scala b/compiler/src/dotty/tools/dotc/cc/Setup.scala
index d69a1aef92227ae48bc2c423c01225f67423c008..335862e1b04ff0009cfb8b6dc8bce8ccab7b58ff 100644
--- a/compiler/src/dotty/tools/dotc/cc/Setup.scala
+++ b/compiler/src/dotty/tools/dotc/cc/Setup.scala
@@ -254,17 +254,29 @@ class Setup extends PreRecheck, SymTransformer, SetupAPI:
 
     protected def innerApply(tp: Type): Type
 
+    // Types that map to themselves (`eq`) contain nothing for Setup to transform under any
+    // traversal state, so they never need re-walking. Without this, deeply-nested alias
+    // unions (e.g. HTML content-category types: hundreds of shared singleton labels behind
+    // several alias layers) are re-expanded once per path through `mapFollowingAliases`,
+    // which is exponential in the alias nesting depth.
+    private val inertTypes = new java.util.IdentityHashMap[Type, Type]()
+
     final def apply(tp: Type) =
-      val saved = isTopLevel
-      if variance < 0 then isTopLevel = false
-      try tp match
-        case defn.RefinedFunctionOf(rinfo: MethodType) =>
-          val rinfo1 = apply(rinfo)
-          if rinfo1 ne rinfo then rinfo1.toFunctionType(alwaysDependent = true)
-          else tp
-        case _ =>
-          innerApply(tp)
-      finally isTopLevel = saved
+      if inertTypes.containsKey(tp) then tp
+      else
+        val saved = isTopLevel
+        if variance < 0 then isTopLevel = false
+        try
+          val tp1 = tp match
+            case defn.RefinedFunctionOf(rinfo: MethodType) =>
+              val rinfo1 = apply(rinfo)
+              if rinfo1 ne rinfo then rinfo1.toFunctionType(alwaysDependent = true)
+              else tp
+            case _ =>
+              innerApply(tp)
+          if tp1 eq tp then inertTypes.put(tp, tp)
+          tp1
+        finally isTopLevel = saved
 
     override def mapArg(arg: Type, tparam: ParamInfo): Type =
       super.mapArg(Recheck.mapExprType(arg), tparam)
