From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jon Pretty <jon.pretty@propensive.com>
Date: Fri, 17 Jul 2026 15:22:52 +0200
Subject: cc: do not box pure types with vacuous or pure-tuple capture sets

Capture checking wrongly rejected or altered values of pure types in two related
situations that arise when an inline typeclass method yielding a pure-typed value is
re-checked under capture checking:

1. direct-mint: a pure parent (e.g. an opaque type bounded by `caps.Pure`) acquires a
   kept-but-empty capture set `T^{}`, which `finalizeCapturing` rejected with "T is a
   pure type, it makes no sense to add a capture set to it". We now strip a vacuously
   empty capture set on an always-pure parent instead of failing; a genuinely non-empty
   set on a pure type (e.g. `Int^`) still errors as before.

2. fresh-var: a tuple of pure elements in an invariant (type-member) position acquired a
   fresh capture-set variable `^'sN`, so a derived typeclass method's parameter type no
   longer overrode the trait's pure member. `needsVariable` now treats a tuple type as
   capturing exactly what its element types capture, so an all-pure tuple needs no
   variable.

Adds two pos regression tests reduced from real code (an opaque `Text.decompose` and a
`Quanta{ type Form = (Pounds, Stones) }.show`).

Enabled by `-Z:unboxed-pure-types`; without it, upstream's code runs at every site this
patch touches.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Proscala-Patch: unboxedpure
---
 compiler/src/dotty/tools/dotc/cc/Setup.scala  | 23 ++++++++++++++-
 .../captures/pure-tuple-typemember-box.scala  | 28 +++++++++++++++++++
 .../captures/pure-type-inline-box.scala       | 24 ++++++++++++++++
 3 files changed, 74 insertions(+), 1 deletion(-)
 create mode 100644 tests/pos-custom-args/captures/pure-tuple-typemember-box.scala
 create mode 100644 tests/pos-custom-args/captures/pure-type-inline-box.scala

diff --git a/compiler/src/dotty/tools/dotc/cc/Setup.scala b/compiler/src/dotty/tools/dotc/cc/Setup.scala
index db5d85e4d21d74e48292765dddea5ee9de160929..488523b56d198bf1e07836109f1fdb5099b309f1 100644
--- a/compiler/src/dotty/tools/dotc/cc/Setup.scala
+++ b/compiler/src/dotty/tools/dotc/cc/Setup.scala
@@ -495,6 +495,17 @@ class Setup extends PreRecheck, SymTransformer, SetupAPI:
        *  2. Map GlobalFresh to ResultCap in capturing types
        */
       def finalizeCapturing(tp: Type): Type = tp match
+        case CapturingType(parent, refs)
+        if parent.isAlwaysPure && refs.elems.isEmpty
+           && config.Proscala.enabled(config.Proscala.UnboxedPureTypes) =>
+          // A vacuously-empty capture set on an always-pure parent carries no information.
+          // Such a `T^{}` can be synthesised when an inline definition that yields a
+          // pure-typed value (e.g. an inline typeclass method returning an opaque pure type)
+          // is re-checked under capture checking: the explicit result-type tree is finalized
+          // with a kept, but empty, capture set. Strip it rather than rejecting the harmless
+          // box (which would otherwise fail with "T is a pure type, it makes no sense to add
+          // a capture set to it" at call sites that are, in fact, pure).
+          parent
         case CapturingType(parent, refs) =>
           if parent.isAlwaysPure && !tptToCheck.span.isZeroExtent then
             // If tptToCheck is zero-extent it could be copied from an overridden
@@ -1001,7 +1012,17 @@ class Setup extends PreRecheck, SymTransformer, SetupAPI:
       case tp: (TypeRef | AppliedType) =>
         val sym = tp.typeSymbol
         if sym.isClass then
-          !sym.isPureClass && sym != defn.AnyClass
+          tp.tupleElementTypes match
+            case Some(elems) if config.Proscala.enabled(config.Proscala.UnboxedPureTypes) =>
+              // A tuple type captures exactly what its elements do: a tuple of pure
+              // elements is itself pure and needs no capture-set variable. Without this,
+              // an all-pure tuple in an invariant (type-member) position acquires a fresh
+              // capture variable `^'sN` that fails to unify with the pure tuple it should
+              // equal (e.g. a derived typeclass method's parameter no longer overrides the
+              // trait's pure member).
+              elems.exists(needsVariable)
+            case _ =>
+              !sym.isPureClass && sym != defn.AnyClass
         else
           val tp1 = tp.dealiasKeepAnnotsAndOpaques
           if tp1 ne tp then needsVariable(tp1)
diff --git a/tests/pos-custom-args/captures/pure-tuple-typemember-box.scala b/tests/pos-custom-args/captures/pure-tuple-typemember-box.scala
new file mode 100644
index 0000000000000000000000000000000000000000..0c915c187de9cd185429b80c336f8db757e8f163
--- /dev/null
+++ b/tests/pos-custom-args/captures/pure-tuple-typemember-box.scala
@@ -0,0 +1,28 @@
+import language.experimental.captureChecking
+import language.experimental.modularity
+import scala.caps
+
+// A tuple of pure elements is itself pure and must not acquire a fresh capture-set variable
+// in an invariant (type-member) position. Previously the derived `Showable`'s `text` method
+// gained a parameter type `Quanta{ type Form = (Pounds,Stones)^'s1 }` which no longer
+// overrode the trait's pure `text(value: Self)`.
+
+class Pounds extends caps.Pure
+class Stones extends caps.Pure
+
+trait Showable extends caps.Pure:
+  type Self
+  def text(value: Self): String
+
+trait Quanta extends caps.Pure:
+  type Form
+
+inline given showable: [Q <: Quanta] => Q is Showable = new Showable:
+  type Self = Q
+  def text(value: Q): String = "x"
+
+extension [L](left: L)
+  inline def show(using value: L is Showable): String = value.text(left)
+
+val q: Quanta { type Form = (Pounds, Stones) } = new Quanta { type Form = (Pounds, Stones) }
+val s: String = q.show
diff --git a/tests/pos-custom-args/captures/pure-type-inline-box.scala b/tests/pos-custom-args/captures/pure-type-inline-box.scala
new file mode 100644
index 0000000000000000000000000000000000000000..02af152178173f9feb4f4bf3da5ad3fcae6d57b0
--- /dev/null
+++ b/tests/pos-custom-args/captures/pure-type-inline-box.scala
@@ -0,0 +1,24 @@
+import language.experimental.captureChecking
+import language.experimental.modularity
+import scala.caps
+
+// A value of a *pure* type must not acquire a capture set when it flows out of an inline
+// given of a `Self`-typeclass instantiated at that pure type, via an inline extension.
+// Previously this produced: "Text is a pure type, it makes no sense to add a capture set to it".
+
+opaque type Text <: Matchable & caps.Pure = String & caps.Pure
+object Text:
+  def apply(s: String): Text = s.asInstanceOf[Text]
+
+trait Decomposable extends caps.Pure:
+  type Self
+  def decomposition(value: Self): Text
+
+inline given derived: [entity] => entity is Decomposable = new Decomposable:
+  type Self = entity
+  def decomposition(value: entity): Text = Text("x")
+
+extension [left](left: left)
+  inline def decompose(using value: left is Decomposable): Text = value.decomposition(left)
+
+val d: Text = Text("hello").decompose
