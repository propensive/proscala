From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jon Pretty <jon.pretty@propensive.com>
Date: Fri, 17 Jul 2026 15:22:50 +0200
Subject: Resolve permitted subclasses lazily when parsing classfiles

Parsing a PermittedSubclasses attribute resolved each permitted class
eagerly during the enclosing symbol's completion. A sealed Java
interface may permit an implementation class whose signature leads back
to other sealed interfaces in the same library, forming a completion
cycle: the JDK 25 java.lang.classfile API fails with 'Cyclic reference
involving class BufferedMethodBuilder' (scala/scala3#25451). Moving the
resolution inside the deferred annotation tree breaks the cycle; the
child is resolved when the annotation is first forced (e.g. by
exhaustivity checking), after all completions have settled.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Proscala-Patch: permitlazy
---
 .../dotc/core/classfile/ClassfileParser.scala    | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/compiler/src/dotty/tools/dotc/core/classfile/ClassfileParser.scala b/compiler/src/dotty/tools/dotc/core/classfile/ClassfileParser.scala
index 9fc968fe867c10d1be4e11a16ec0a0cdd5274da0..d705cdcd864a243afef0a360960ad7ce8c1142a8 100644
--- a/compiler/src/dotty/tools/dotc/core/classfile/ClassfileParser.scala
+++ b/compiler/src/dotty/tools/dotc/core/classfile/ClassfileParser.scala
@@ -937,12 +937,18 @@ class ClassfileParser(
       }
 
       permittedSubclasses.foreach { child =>
-        val cls = getClassSymbol(child.name)
-        sym.addAnnotation(Annotation.deferredSymAndTree(defn.ChildAnnot)(
+        // Resolve the permitted subclass lazily, inside the deferred annotation tree: a
+        // sealed Java interface may permit an implementation class whose own signature
+        // refers back to (other) sealed interfaces in the same library — resolving the
+        // child during this symbol's completion then forms a completion cycle (e.g. the
+        // JDK 25 `java.lang.classfile` API: MethodModel permits BufferedMethodBuilder$Model,
+        // and BufferedMethodBuilder's parents lead back to the sealed MethodInfo).
+        sym.addAnnotation(Annotation.deferredSymAndTree(defn.ChildAnnot) {
+          val cls = getClassSymbol(child.name)
           New(defn.ChildAnnot.typeRef.appliedTo(cls.owner.thisType.select(cls.name, cls)), Nil)
-          .withSpan(NoSpan)
-          ))
-        }
+            .withSpan(NoSpan)
+        })
+      }
 
       def fillInParamNames(t: Type): Type = t match
         case mt @ MethodType(oldp) if namedParams.nonEmpty =>
